generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiIdempotencyRecord {
  id             String    @id @default(cuid())
  actorId        String    @map("actor_id")
  operation      String
  idempotencyKey String    @map("idempotency_key")
  requestHash    String    @map("request_hash")
  responseStatus Int?      @map("response_status")
  responseJson   Json?     @map("response_json")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")
  actor          User      @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, operation, idempotencyKey])
  @@index([completedAt, createdAt])
  @@map("api_idempotency_records")
}

model SystemSetting {
  key       String                  @id
  value     Json
  valueType SettingValueType        @map("value_type")
  version   Int                     @default(1)
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")
  revisions SystemSettingRevision[]

  @@map("system_settings")
}

model SystemSettingRevision {
  id           String           @id @default(cuid())
  settingKey   String           @map("setting_key")
  version      Int
  value        Json
  valueType    SettingValueType @map("value_type")
  changedById  String?          @map("changed_by_id")
  changeReason String?          @map("change_reason")
  createdAt    DateTime         @default(now()) @map("created_at")
  setting      SystemSetting    @relation(fields: [settingKey], references: [key], onDelete: Restrict)
  changedBy    User?            @relation("SystemSettingRevisionChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@unique([settingKey, version])
  @@index([changedById, createdAt])
  @@map("system_setting_revisions")
}

model CompanyCapability {
  code      CapabilityCode              @id
  enabled   Boolean                     @default(false)
  version   Int                         @default(1)
  createdAt DateTime                    @default(now()) @map("created_at")
  updatedAt DateTime                    @updatedAt @map("updated_at")
  revisions CompanyCapabilityRevision[]

  @@map("company_capabilities")
}

model CompanyCapabilityRevision {
  id             String            @id @default(cuid())
  capabilityCode CapabilityCode    @map("capability_code")
  version        Int
  enabled        Boolean
  changedById    String?           @map("changed_by_id")
  changeReason   String?           @map("change_reason")
  createdAt      DateTime          @default(now()) @map("created_at")
  capability     CompanyCapability @relation(fields: [capabilityCode], references: [code], onDelete: Restrict)
  changedBy      User?             @relation("CompanyCapabilityRevisionChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@unique([capabilityCode, version])
  @@index([changedById, createdAt])
  @@map("company_capability_revisions")
}

model TemplateComponent {
  id             String                     @id @default(cuid())
  code           String                     @unique
  componentType  TemplateComponentType      @map("component_type")
  name           String
  description    String?
  draftContent   Json                       @map("draft_content")
  status         TemplateMasterStatus       @default(DRAFT)
  currentVersion Int                        @default(0) @map("current_version")
  version        Int                        @default(1)
  createdById    String                     @map("created_by_id")
  updatedById    String                     @map("updated_by_id")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")
  createdBy      User                       @relation("TemplateComponentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User                       @relation("TemplateComponentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  versions       TemplateComponentVersion[]

  @@index([componentType, status, code])
  @@map("template_components")
}

model TemplateComponentVersion {
  id             String                @id @default(cuid())
  componentId    String                @map("component_id")
  version        Int
  status         TemplateVersionStatus @default(PUBLISHED)
  componentType  TemplateComponentType @map("component_type")
  name           String
  description    String?
  contentJson    Json                  @map("content_json")
  checksum       String
  publishedById  String                @map("published_by_id")
  publishedAt    DateTime              @default(now()) @map("published_at")
  component      TemplateComponent     @relation(fields: [componentId], references: [id], onDelete: Restrict)
  publishedBy    User                  @relation("TemplateComponentVersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  draftReferences TemplateDraftComponent[]
  versionReferences TemplateVersionComponent[]
  projectSnapshotComponents ProjectTemplateSnapshotComponent[]

  @@unique([componentId, version])
  @@index([componentType, publishedAt])
  @@index([publishedById, publishedAt])
  @@map("template_component_versions")
}

model ProjectTemplate {
  id             String                   @id @default(cuid())
  code           String                   @unique
  name           String
  description    String?
  status         TemplateMasterStatus     @default(DRAFT)
  currentVersion Int                      @default(0) @map("current_version")
  version        Int                      @default(1)
  createdById    String                   @map("created_by_id")
  updatedById    String                   @map("updated_by_id")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  createdBy      User                     @relation("ProjectTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User                     @relation("ProjectTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  draftComponents TemplateDraftComponent[]
  versions       ProjectTemplateVersion[]

  @@index([status, code])
  @@map("templates")
}

model TemplateDraftComponent {
  id                 String                   @id @default(cuid())
  templateId         String                   @map("template_id")
  componentVersionId String                   @map("component_version_id")
  componentType      TemplateComponentType    @map("component_type")
  slot               String
  position           Int
  template           ProjectTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  componentVersion   TemplateComponentVersion @relation(fields: [componentVersionId], references: [id], onDelete: Restrict)

  @@unique([templateId, slot])
  @@unique([templateId, position])
  @@index([componentVersionId])
  @@map("template_draft_components")
}

model ProjectTemplateVersion {
  id            String                     @id @default(cuid())
  templateId    String                     @map("template_id")
  version       Int
  status        TemplateVersionStatus      @default(PUBLISHED)
  name          String
  description   String?
  checksum      String
  publishedById String                     @map("published_by_id")
  publishedAt   DateTime                   @default(now()) @map("published_at")
  template      ProjectTemplate            @relation(fields: [templateId], references: [id], onDelete: Restrict)
  publishedBy   User                       @relation("ProjectTemplateVersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  components    TemplateVersionComponent[]
  sourceProjects Project[]                  @relation("ProjectSourceTemplateVersion")
  projectSnapshots ProjectTemplateSnapshot[] @relation("ProjectSnapshotSourceTemplateVersion")

  @@unique([templateId, version])
  @@index([publishedById, publishedAt])
  @@map("template_versions")
}

model TemplateVersionComponent {
  id                 String                   @id @default(cuid())
  templateVersionId  String                   @map("template_version_id")
  componentVersionId String                   @map("component_version_id")
  componentType      TemplateComponentType    @map("component_type")
  slot               String
  position           Int
  templateVersion    ProjectTemplateVersion   @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  componentVersion   TemplateComponentVersion @relation(fields: [componentVersionId], references: [id], onDelete: Restrict)

  @@unique([templateVersionId, slot])
  @@unique([templateVersionId, position])
  @@index([componentVersionId])
  @@map("template_version_components")
}

model OutboxEvent {
  id             String         @id @default(cuid())
  eventType      String         @map("event_type")
  aggregateType  String         @map("aggregate_type")
  aggregateId    String?        @map("aggregate_id")
  payload        Json
  payloadHash    String         @map("payload_hash")
  idempotencyKey String         @map("idempotency_key")
  traceId        String?        @map("trace_id")
  occurredAt     DateTime       @default(now()) @map("occurred_at")
  dispatchedAt   DateTime?      @map("dispatched_at")
  job            PersistentJob?

  @@unique([eventType, idempotencyKey])
  @@index([dispatchedAt, occurredAt])
  @@index([traceId, occurredAt])
  @@map("outbox_events")
}

model PersistentJob {
  id                  String       @id @default(cuid())
  sourceOutboxEventId String?      @unique @map("source_outbox_event_id")
  jobType             String       @map("job_type")
  payload             Json
  payloadHash         String       @map("payload_hash")
  idempotencyKey      String       @map("idempotency_key")
  traceId             String?      @map("trace_id")
  status              JobStatus    @default(PENDING)
  maxAttempts         Int          @map("max_attempts")
  attemptCount        Int          @default(0) @map("attempt_count")
  cycleAttemptCount   Int          @default(0) @map("cycle_attempt_count")
  nextRunAt           DateTime     @default(now()) @map("next_run_at")
  lockedAt            DateTime?    @map("locked_at")
  lockedBy            String?      @map("locked_by")
  leaseExpiresAt      DateTime?    @map("lease_expires_at")
  lastErrorCode       String?      @map("last_error_code")
  lastErrorMessage    String?      @map("last_error_message")
  completedAt         DateTime?    @map("completed_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  sourceOutboxEvent   OutboxEvent? @relation(fields: [sourceOutboxEventId], references: [id], onDelete: Restrict)
  attempts            JobAttempt[]

  @@unique([jobType, idempotencyKey])
  @@index([status, nextRunAt])
  @@index([status, leaseExpiresAt])
  @@index([traceId, createdAt])
  @@map("persistent_jobs")
}

model JobAttempt {
  id            String           @id @default(cuid())
  jobId         String           @map("job_id")
  attemptNumber Int              @map("attempt_number")
  status        JobAttemptStatus @default(QUEUED)
  availableAt   DateTime         @default(now()) @map("available_at")
  startedAt     DateTime?        @map("started_at")
  completedAt   DateTime?        @map("completed_at")
  workerId      String?          @map("worker_id")
  errorCode     String?          @map("error_code")
  errorMessage  String?          @map("error_message")
  isReplay      Boolean          @default(false) @map("is_replay")
  requestedById String?          @map("requested_by_id")
  replayReason  String?          @map("replay_reason")
  createdAt     DateTime         @default(now()) @map("created_at")
  job           PersistentJob    @relation(fields: [jobId], references: [id], onDelete: Restrict)
  requestedBy   User?            @relation("JobAttemptRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@unique([jobId, attemptNumber])
  @@index([status, availableAt])
  @@index([requestedById, createdAt])
  @@map("job_attempts")
}

model FileObject {
  id               String             @id @default(cuid())
  projectId        String             @map("project_id")
  uploadedById     String             @map("uploaded_by_id")
  originalName     String             @map("original_name")
  declaredMimeType String             @map("declared_mime_type")
  verifiedMimeType String?            @map("verified_mime_type")
  declaredSize     BigInt             @map("declared_size")
  verifiedSize     BigInt?            @map("verified_size")
  sha256           String?
  objectKey        String             @unique @map("object_key")
  storageArea      FileStorageArea    @default(QUARANTINE) @map("storage_area")
  status           FileObjectStatus   @default(UPLOADING)
  sensitivity      FileSensitivity    @default(INTERNAL)
  scanEngine       String?            @map("scan_engine")
  scannerVersion   String?            @map("scanner_version")
  scanSignature    String?            @map("scan_signature")
  scannedAt        DateTime?          @map("scanned_at")
  failureCode      String?            @map("failure_code")
  failureMessage   String?            @map("failure_message")
  version          Int                @default(1)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  uploadedBy       User               @relation("FileObjectUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadSession    FileUploadSession?
  commands         FileCommand[]

  @@index([projectId, status, createdAt])
  @@index([uploadedById, createdAt])
  @@map("file_objects")
}

model FileUploadSession {
  id              String                  @id @default(cuid())
  fileObjectId    String                  @unique @map("file_object_id")
  storageUploadId String                  @unique @map("storage_upload_id")
  status          FileUploadSessionStatus @default(INITIATED)
  expectedParts   Int                     @map("expected_parts")
  partSize        BigInt                  @map("part_size")
  expiresAt       DateTime                @map("expires_at")
  completedAt     DateTime?               @map("completed_at")
  failureCode     String?                 @map("failure_code")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  fileObject      FileObject              @relation(fields: [fileObjectId], references: [id], onDelete: Restrict)
  parts           FileUploadPart[]
  commands        FileCommand[]

  @@index([status, expiresAt])
  @@map("file_upload_sessions")
}

model FileUploadPart {
  uploadSessionId String            @map("upload_session_id")
  partNumber      Int               @map("part_number")
  expectedSize    BigInt            @map("expected_size")
  completedSize   BigInt?           @map("completed_size")
  etag            String?
  uploadSession   FileUploadSession @relation(fields: [uploadSessionId], references: [id], onDelete: Restrict)

  @@id([uploadSessionId, partNumber])
  @@map("file_upload_parts")
}

model FileCommand {
  id               String            @id @default(cuid())
  actorId          String            @map("actor_id")
  fileObjectId     String            @map("file_object_id")
  uploadSessionId  String?           @map("upload_session_id")
  operation        FileCommandType
  idempotencyKey   String            @map("idempotency_key")
  payloadHash      String            @map("payload_hash")
  status           FileCommandStatus @default(STARTED)
  responseJson     Json?             @map("response_json")
  errorCode        String?           @map("error_code")
  errorMessage     String?           @map("error_message")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  actor            User              @relation("FileCommandActor", fields: [actorId], references: [id], onDelete: Restrict)
  fileObject       FileObject        @relation(fields: [fileObjectId], references: [id], onDelete: Restrict)
  uploadSession    FileUploadSession? @relation(fields: [uploadSessionId], references: [id], onDelete: Restrict)

  @@unique([actorId, operation, idempotencyKey])
  @@unique([uploadSessionId, operation])
  @@index([fileObjectId, createdAt])
  @@map("file_commands")
}

model NotificationTemplate {
  code           String                        @id
  enabled        Boolean                       @default(true)
  currentVersion Int                           @default(0) @map("current_version")
  version        Int                           @default(1)
  createdAt      DateTime                      @default(now()) @map("created_at")
  updatedAt      DateTime                      @updatedAt @map("updated_at")
  versions       NotificationTemplateVersion[]

  @@map("notification_templates")
}

model NotificationTemplateVersion {
  id              String               @id @default(cuid())
  templateCode    String               @map("template_code")
  version         Int
  subjectTemplate String               @map("subject_template")
  bodyTextTemplate String              @map("body_text_template")
  bodyHtmlTemplate String?             @map("body_html_template")
  variableSchema  Json                 @map("variable_schema")
  publishedById   String?              @map("published_by_id")
  publishedAt     DateTime             @default(now()) @map("published_at")
  template        NotificationTemplate @relation(fields: [templateCode], references: [code], onDelete: Restrict)
  publishedBy     User?                @relation("NotificationTemplatePublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  notifications   Notification[]

  @@unique([templateCode, version])
  @@index([publishedById, publishedAt])
  @@map("notification_template_versions")
}

model Notification {
  id                String                      @id @default(cuid())
  sourceEventKey    String                      @map("source_event_key")
  eventType         String                      @map("event_type")
  recipientId       String                      @map("recipient_id")
  projectId         String?                     @map("project_id")
  templateVersionId String                      @map("template_version_id")
  payloadHash       String                      @map("payload_hash")
  subject           String
  bodyText          String                      @map("body_text")
  bodyHtml          String?                     @map("body_html")
  targetPath        String?                     @map("target_path")
  sensitivity       NotificationSensitivity     @default(INTERNAL)
  createdAt         DateTime                    @default(now()) @map("created_at")
  recipient         User                        @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  project           Project?                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  templateVersion   NotificationTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  readReceipt       NotificationReadReceipt?
  deliveries        NotificationDelivery[]

  @@unique([sourceEventKey, recipientId])
  @@unique([id, recipientId])
  @@index([recipientId, createdAt])
  @@index([recipientId, sensitivity, createdAt])
  @@index([projectId, createdAt])
  @@map("notifications")
}

model NotificationReadReceipt {
  id             String       @id @default(cuid())
  notificationId String       @unique @map("notification_id")
  recipientId    String       @map("recipient_id")
  readAt         DateTime     @default(now()) @map("read_at")
  notification   Notification @relation(fields: [notificationId, recipientId], references: [id, recipientId], onDelete: Restrict)
  recipient      User         @relation("NotificationReadRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([recipientId, readAt])
  @@unique([notificationId, recipientId])
  @@map("notification_read_receipts")
}

model NotificationDelivery {
  id                String                     @id @default(cuid())
  notificationId    String                     @map("notification_id")
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  idempotencyKey    String                     @unique @map("idempotency_key")
  sentAt            DateTime?                  @map("sent_at")
  providerMessageId String?                    @map("provider_message_id")
  lastErrorCode     String?                    @map("last_error_code")
  lastErrorMessage  String?                    @map("last_error_message")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  attempts          NotificationDeliveryAttempt[]

  @@unique([notificationId, channel])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

model NotificationDeliveryAttempt {
  id                String                            @id @default(cuid())
  deliveryId        String                            @map("delivery_id")
  attemptNumber     Int                               @map("attempt_number")
  status            NotificationDeliveryAttemptStatus @default(RUNNING)
  startedAt         DateTime                          @default(now()) @map("started_at")
  completedAt       DateTime?                         @map("completed_at")
  providerMessageId String?                           @map("provider_message_id")
  errorCode         String?                           @map("error_code")
  errorMessage      String?                           @map("error_message")
  delivery          NotificationDelivery              @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@unique([deliveryId, attemptNumber])
  @@map("notification_delivery_attempts")
}

enum SettingValueType {
  BOOLEAN
  INTEGER
  STRING
  JSON
}

enum CapabilityCode {
  SUPPLIER_COLLABORATION
  CUSTOMER_PROGRESS_SHARING
  AI_ISSUE_INTAKE
  UPH_ANALYSIS
  INCENTIVE_MANAGEMENT
}

enum JobStatus {
  PENDING
  RUNNING
  RETRY_SCHEDULED
  SUCCEEDED
  DEAD_LETTER
}

enum JobAttemptStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum TemplateComponentType {
  STAGE
  GATE
  ROLE
  WBS
  CAPABILITY_RULE
}

enum TemplateMasterStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum TemplateVersionStatus {
  PUBLISHED
}

enum FileObjectStatus {
  UPLOADING
  PENDING_SCAN
  AVAILABLE
  QUARANTINED
  FAILED
}

enum FileStorageArea {
  QUARANTINE
  CONTROLLED
}

enum FileSensitivity {
  INTERNAL
  RESTRICTED
}

enum FileUploadSessionStatus {
  INITIATED
  COMPLETING
  COMPLETED
  FAILED
  ABORTED
}

enum FileCommandType {
  UPLOAD_COMPLETE
}

enum FileCommandStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum NotificationSensitivity {
  INTERNAL
  RESTRICTED
}

enum NotificationChannel {
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  RETRYING
  SENT
  DEAD_LETTER
}

enum NotificationDeliveryAttemptStatus {
  RUNNING
  SENT
  FAILED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PermissionScope {
  ALL
  DEPARTMENT
  PROJECT
  SELF
  ASSIGNED
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  GATE_REVIEW
  SUSPENDED
  CLOSED
  CANCELED
}

enum ProjectInitializationStatus {
  LEGACY
  READY
}

enum ProjectType {
  LEGACY
  CUSTOMER_DELIVERY
  INTERNAL_RND
}

enum EquipmentShape {
  SINGLE_MACHINE
  LINE
}

enum ProjectStructureStatus {
  UNCONFIGURED
  READY
}

enum DeliveryUnitType {
  LINE
  AREA
  MACHINE
}

enum ProjectStructureNodeStatus {
  ACTIVE
  DISABLED
}

enum ProjectRole {
  PROJECT_MANAGER
  DEPARTMENT_LEAD
  ENGINEER
  PROCUREMENT
  QUALITY
  VIEWER
}

enum AuditAction {
  AUTHORIZATION_DENIED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_ENDED
  AUDIT_LOG_READ
  CONFIGURATION_SETTING_CHANGED
  COMPANY_CAPABILITY_CHANGED
  JOB_REPLAYED
  FILE_UPLOAD_STARTED
  FILE_UPLOAD_COMPLETED
  FILE_SCAN_COMPLETED
  FILE_QUARANTINED
  FILE_PROCESSING_FAILED
  FILE_DOWNLOAD_URL_ISSUED
  NOTIFICATION_TEMPLATE_PUBLISHED
  NOTIFICATION_TEMPLATE_STATUS_CHANGED
  NOTIFICATION_CREATED
  NOTIFICATION_INBOX_READ
  NOTIFICATION_MARKED_READ
  NOTIFICATION_DELIVERED
  TEMPLATE_COMPONENT_DRAFT_SAVED
  TEMPLATE_COMPONENT_PUBLISHED
  TEMPLATE_COMPONENT_STATUS_CHANGED
  TEMPLATE_DRAFT_SAVED
  TEMPLATE_PUBLISHED
  TEMPLATE_STATUS_CHANGED
  PROJECT_CREATED
  PROJECT_STRUCTURE_INITIALIZED
  DELIVERY_UNIT_STATUS_CHANGED
}

enum AuditObjectType {
  PROJECT
  PROJECT_MEMBER
  AUDIT_LOG
  SYSTEM_SETTING
  COMPANY_CAPABILITY
  OUTBOX_EVENT
  PERSISTENT_JOB
  FILE_OBJECT
  FILE_UPLOAD_SESSION
  NOTIFICATION_TEMPLATE
  NOTIFICATION
  NOTIFICATION_DELIVERY
  TEMPLATE_COMPONENT
  TEMPLATE
  TEMPLATE_VERSION
  DELIVERY_UNIT
  PROJECT_MODULE
}

enum AuditSource {
  API
  WORKER
  SCHEDULER
  SYSTEM
  INTEGRATION
  EXTERNAL_API
}

enum AuditResult {
  SUCCESS
  DENIED
  FAILURE
}

model User {
  id                  String                      @id @default(cuid())
  employeeNo          String                      @unique @map("employee_no")
  name                String
  email               String?                     @unique
  departmentId        String?                     @map("department_id")
  status              UserStatus                  @default(ACTIVE)
  version             Int                         @default(1)
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")
  roleAssignments     UserRole[]                  @relation("RoleAssignmentUser")
  rolesAssigned       UserRole[]                  @relation("RoleAssignmentActor")
  memberships         ProjectMember[]             @relation("ProjectMemberUser")
  membershipsAssigned ProjectMember[]             @relation("ProjectMemberAssignedBy")
  membershipsEnded    ProjectMember[]             @relation("ProjectMemberLeftBy")
  projectsCreated     Project[]                   @relation("ProjectCreatedBy")
  auditLogs           AuditLog[]
  settingRevisions    SystemSettingRevision[]     @relation("SystemSettingRevisionChangedBy")
  capabilityRevisions CompanyCapabilityRevision[] @relation("CompanyCapabilityRevisionChangedBy")
  requestedJobReplays JobAttempt[]                @relation("JobAttemptRequestedBy")
  filesUploaded       FileObject[]                 @relation("FileObjectUploadedBy")
  fileCommands        FileCommand[]                @relation("FileCommandActor")
  notificationTemplateVersionsPublished NotificationTemplateVersion[] @relation("NotificationTemplatePublishedBy")
  notificationsReceived Notification[]             @relation("NotificationRecipient")
  notificationReadReceipts NotificationReadReceipt[] @relation("NotificationReadRecipient")
  apiIdempotencyRecords ApiIdempotencyRecord[]
  templateComponentsCreated TemplateComponent[]        @relation("TemplateComponentCreatedBy")
  templateComponentsUpdated TemplateComponent[]        @relation("TemplateComponentUpdatedBy")
  templateComponentVersionsPublished TemplateComponentVersion[] @relation("TemplateComponentVersionPublishedBy")
  projectTemplatesCreated ProjectTemplate[]             @relation("ProjectTemplateCreatedBy")
  projectTemplatesUpdated ProjectTemplate[]             @relation("ProjectTemplateUpdatedBy")
  projectTemplateVersionsPublished ProjectTemplateVersion[] @relation("ProjectTemplateVersionPublishedBy")
  deliveryUnitsCreated DeliveryUnit[] @relation("DeliveryUnitCreatedBy")
  deliveryUnitsUpdated DeliveryUnit[] @relation("DeliveryUnitUpdatedBy")
  projectModulesCreated ProjectModule[] @relation("ProjectModuleCreatedBy")
  projectModulesUpdated ProjectModule[] @relation("ProjectModuleUpdatedBy")

  @@index([departmentId])
  @@map("users")
}

model Role {
  id          String           @id
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(true) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id
  code        String           @unique
  description String
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String          @map("role_id")
  permissionId String          @map("permission_id")
  scope        PermissionScope
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  roleId       String    @map("role_id")
  assignedById String?   @map("assigned_by_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  revokedAt    DateTime? @map("revoked_at")
  user         User      @relation("RoleAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy   User?     @relation("RoleAssignmentActor", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([roleId])
  @@map("user_roles")
}

model Project {
  id                      String                      @id @default(cuid())
  code                    String                      @unique
  name                    String
  departmentId            String?                     @map("department_id")
  status                  ProjectStatus               @default(DRAFT)
  initializationStatus    ProjectInitializationStatus @default(LEGACY) @map("initialization_status")
  projectType             ProjectType                 @default(LEGACY) @map("project_type")
  equipmentShape          EquipmentShape?             @map("equipment_shape")
  structureStatus         ProjectStructureStatus      @default(UNCONFIGURED) @map("structure_status")
  sourceTemplateVersionId String?                     @map("source_template_version_id")
  sourceTemplateChecksum  String?                     @map("source_template_checksum")
  initializedAt           DateTime?                   @map("initialized_at")
  version                 Int                         @default(1)
  createdById             String                      @map("created_by_id")
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")
  createdBy               User                        @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sourceTemplateVersion   ProjectTemplateVersion?     @relation("ProjectSourceTemplateVersion", fields: [sourceTemplateVersionId], references: [id], onDelete: Restrict)
  templateSnapshot        ProjectTemplateSnapshot?
  members                 ProjectMember[]
  auditLogs               AuditLog[]
  files                   FileObject[]
  notifications           Notification[]
  deliveryUnits           DeliveryUnit[]
  projectModules          ProjectModule[]

  @@index([departmentId])
  @@index([sourceTemplateVersionId])
  @@index([initializationStatus, createdAt])
  @@index([projectType, equipmentShape, structureStatus])
  @@map("projects")
}

model ProjectTemplateSnapshot {
  id                      String                             @id @default(cuid())
  projectId               String                             @unique @map("project_id")
  sourceTemplateVersionId String                             @map("source_template_version_id")
  sourceTemplateChecksum  String                             @map("source_template_checksum")
  snapshotChecksum        String                             @map("snapshot_checksum")
  templateCode            String                             @map("template_code")
  templateName            String                             @map("template_name")
  templateVersion         Int                                @map("template_version")
  templatePublishedAt     DateTime                           @map("template_published_at")
  createdAt               DateTime                           @default(now()) @map("created_at")
  project                 Project                            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sourceTemplateVersion   ProjectTemplateVersion             @relation("ProjectSnapshotSourceTemplateVersion", fields: [sourceTemplateVersionId], references: [id], onDelete: Restrict)
  components              ProjectTemplateSnapshotComponent[]

  @@index([sourceTemplateVersionId, createdAt])
  @@map("project_template_snapshots")
}

model ProjectTemplateSnapshotComponent {
  id                       String                   @id @default(cuid())
  snapshotId               String                   @map("snapshot_id")
  sourceComponentVersionId String                   @map("source_component_version_id")
  componentType            TemplateComponentType    @map("component_type")
  slot                     String
  position                 Int
  sourceChecksum           String                   @map("source_checksum")
  componentCode            String                   @map("component_code")
  componentName            String                   @map("component_name")
  componentVersion         Int                      @map("component_version")
  description              String?
  contentJson              Json                     @map("content_json")
  snapshot                 ProjectTemplateSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  sourceComponentVersion   TemplateComponentVersion @relation(fields: [sourceComponentVersionId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, slot])
  @@unique([snapshotId, position])
  @@index([sourceComponentVersionId])
  @@map("project_template_snapshot_components")
}

model DeliveryUnit {
  id          String                     @id @default(cuid())
  projectId   String                     @map("project_id")
  parentId    String?                    @map("parent_id")
  unitType    DeliveryUnitType           @map("unit_type")
  code        String
  name        String
  status      ProjectStructureNodeStatus @default(ACTIVE)
  position    Int
  version     Int                        @default(1)
  createdById String                     @map("created_by_id")
  updatedById String                     @map("updated_by_id")
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")
  project     Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  parent      DeliveryUnit?              @relation("DeliveryUnitHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    DeliveryUnit[]             @relation("DeliveryUnitHierarchy")
  modules     ProjectModule[]
  createdBy   User                       @relation("DeliveryUnitCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User                       @relation("DeliveryUnitUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([projectId, code])
  @@unique([id, projectId])
  @@unique([projectId, parentId, position])
  @@index([projectId, unitType, status])
  @@index([parentId, position])
  @@map("delivery_units")
}

model ProjectModule {
  id             String                     @id @default(cuid())
  projectId      String                     @map("project_id")
  deliveryUnitId String                     @map("delivery_unit_id")
  code           String
  name           String
  status         ProjectStructureNodeStatus @default(ACTIVE)
  position       Int
  version        Int                        @default(1)
  createdById    String                     @map("created_by_id")
  updatedById    String                     @map("updated_by_id")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")
  project        Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  deliveryUnit   DeliveryUnit               @relation(fields: [deliveryUnitId], references: [id], onDelete: Restrict)
  createdBy      User                       @relation("ProjectModuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User                       @relation("ProjectModuleUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([projectId, code])
  @@unique([deliveryUnitId, position])
  @@index([projectId, status])
  @@index([deliveryUnitId, status])
  @@map("project_modules")
}

model ProjectMember {
  id           String      @id @default(cuid())
  projectId    String      @map("project_id")
  userId       String      @map("user_id")
  projectRole  ProjectRole @map("project_role")
  departmentId String?     @map("department_id")
  assignedById String      @map("assigned_by_id")
  joinedAt     DateTime    @default(now()) @map("joined_at")
  leftAt       DateTime?   @map("left_at")
  leftById     String?     @map("left_by_id")
  version      Int         @default(1)
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user         User        @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy   User        @relation("ProjectMemberAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  leftBy       User?       @relation("ProjectMemberLeftBy", fields: [leftById], references: [id], onDelete: Restrict)

  @@index([projectId, leftAt])
  @@index([userId, leftAt])
  @@map("project_members")
}

model AuditLog {
  id           String          @id @default(cuid())
  actorId      String?         @map("actor_id")
  action       AuditAction
  objectType   AuditObjectType @map("object_type")
  objectId     String?         @map("object_id")
  projectId    String?         @map("project_id")
  departmentId String?         @map("department_id")
  requestId    String?         @map("request_id")
  traceId      String?         @map("trace_id")
  operationId  String?         @map("operation_id")
  beforeJson   Json?           @map("before_json")
  afterJson    Json?           @map("after_json")
  metadataJson Json?           @map("metadata_json")
  source       AuditSource
  sourceIp     String?         @map("source_ip")
  userAgent    String?         @map("user_agent")
  reason       String?
  result       AuditResult     @default(SUCCESS)
  occurredAt   DateTime        @default(now()) @map("occurred_at")
  actor        User?           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([actorId, occurredAt])
  @@index([objectType, objectId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([departmentId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}
