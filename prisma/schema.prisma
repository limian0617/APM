  sourceDependencyId String           @map("source_dependency_id")
  snapshotJson       Json             @map("snapshot_json")
  createdAt          DateTime         @default(now()) @map("created_at")
  baseline           PlanningBaseline @relation(fields: [baselineId, projectId], references: [id, projectId], onDelete: Restrict)

  @@unique([baselineId, sourceDependencyId])
  @@index([projectId, baselineId])
  @@map("planning_baseline_dependency_snapshots")
}

