  createdAt                     DateTime                             @default(now()) @map("created_at")
  updatedAt                     DateTime                             @updatedAt @map("updated_at")
  createdBy                     User                                 @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sourceTemplateVersion         ProjectTemplateVersion?              @relation("ProjectSourceTemplateVersion", fields: [sourceTemplateVersionId], references: [id], onDelete: Restrict)
  templateSnapshot              ProjectTemplateSnapshot?
  mainControlStage              ProjectStage?                        @relation("ProjectMainControlStage", fields: [mainControlStageId, mainControlStageProjectId], references: [id, projectId], onDelete: Restrict)
  members                       ProjectMember[]
  auditLogs                     AuditLog[]
  files                         FileObject[]
  controlledDocuments           ControlledDocument[]
  controlledDocumentVersions    ControlledDocumentVersion[]
  notifications                 Notification[]
  deliveryUnits                 DeliveryUnit[]
  projectModules                ProjectModule[]
  projectCapabilities           ProjectCapability[]
  responsibilityPackages        ResponsibilityPackage[]
  projectMilestones             ProjectMilestone[]
  projectMilestoneTaskLinks     ProjectMilestoneTaskLink[]
  projectMilestoneEvents        ProjectMilestoneEvent[]
  projectStages                 ProjectStage[]                       @relation("ProjectStages")
  deliveryUnitStages            DeliveryUnitStage[]
  stageReleaseAuthorizations    StageReleaseAuthorization[]
  projectStageEvents            ProjectStageEvent[]
  gateDefinitions               ProjectGateDefinition[]
  gateInstances                 ProjectGateInstance[]
  gateCheckSnapshots            GateCheckSnapshot[]
  gateCheckResults              GateCheckResult[]
  gateSubmissions               GateSubmission[]
  gateSubmissionApprovers       GateSubmissionApprover[]
  gateApprovals                 GateApproval[]
  gateSubmissionEvents          GateSubmissionEvent[]
  gateConditionalReleases       GateConditionalRelease[]
  residualItems                 ResidualItem[]
  residualItemEvents            ResidualItemEvent[]
  alertRules                    ProjectAlertRule[]
  alerts                        ProjectAlert[]
  alertEvents                   ProjectAlertEvent[]
  alertScans                    ProjectAlertScan[]
  wbsNodes                      WbsNode[]
  planningTasks                 PlanningTask[]
  planningCalendar              ProjectCalendar?
  projectCalendarRevisions      ProjectCalendarRevision[]
  taskDependencies              TaskDependency[]
  scheduleState                 ProjectScheduleState?
  scheduleRecalculations        ScheduleRecalculation[]
  scheduleTaskForecasts         ScheduleTaskForecast[]
  planningBaselines             PlanningBaseline[]

  @@index([departmentId])
  @@index([sourceTemplateVersionId])
  @@index([initializationStatus, createdAt])
  @@index([projectType, equipmentShape, structureStatus])
  @@index([capabilityConfigurationStatus, createdAt])
  @@unique([mainControlStageId, mainControlStageProjectId])
  @@map("projects")
}

model ControlledDocument {
  id                        String                   @id @default(cuid())
  projectId                 String                   @map("project_id")
  code                      String
  title                     String
  status                    ControlledDocumentStatus @default(ACTIVE)
  currentPublishedVersionId String?                  @map("current_published_version_id")
  version                   Int                      @default(1)
  createdById               String                   @map("created_by_id")
  voidedById                String?                  @map("voided_by_id")
  voidedAt                  DateTime?                @map("voided_at")
  voidReason                String?                  @map("void_reason")
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")
  project                   Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy                 User                     @relation("ControlledDocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy                  User?                    @relation("ControlledDocumentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  currentPublishedVersion   ControlledDocumentVersion? @relation("DocumentCurrentPublishedVersion", fields: [currentPublishedVersionId, projectId], references: [id, projectId], onDelete: Restrict)
  versions                  ControlledDocumentVersion[] @relation("ControlledDocumentVersions")

  @@unique([projectId, code])
  @@unique([id, projectId])
  @@unique([currentPublishedVersionId, projectId])
  @@index([projectId, status, code])
  @@index([createdById, createdAt])
  @@map("controlled_documents")
}

model ControlledDocumentVersion {
  id                  String                          @id @default(cuid())
  documentId          String                          @map("document_id")
  projectId           String                          @map("project_id")
  version             Int
  status              ControlledDocumentVersionStatus @default(DRAFT)
  sourceFileId        String                          @map("source_file_id")
  sourceFileSha256    String                          @map("source_file_sha256")
  sourceMimeType      String                          @map("source_mime_type")
  sourceFileSize      BigInt                          @map("source_file_size")
  createdById         String                          @map("created_by_id")
  publishedById       String?                         @map("published_by_id")
  publishedAt         DateTime?                       @map("published_at")
  voidedById          String?                         @map("voided_by_id")
  voidedAt            DateTime?                       @map("voided_at")
  voidReason          String?                         @map("void_reason")
  createdAt           DateTime                        @default(now()) @map("created_at")
  document            ControlledDocument              @relation("ControlledDocumentVersions", fields: [documentId, projectId], references: [id, projectId], onDelete: Restrict)
  project             Project                         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sourceFile          FileObject                      @relation("DocumentVersionSourceFile", fields: [sourceFileId, projectId], references: [id, projectId], onDelete: Restrict)
  createdBy           User                            @relation("ControlledDocumentVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy         User?                           @relation("ControlledDocumentVersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  voidedBy            User?                           @relation("ControlledDocumentVersionVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  currentForDocument  ControlledDocument?             @relation("DocumentCurrentPublishedVersion")

  @@unique([documentId, version])
  @@unique([id, projectId])
  @@index([projectId, status, createdAt])
  @@index([sourceFileId])
  @@map("controlled_document_versions")
}

model ProjectTemplateSnapshot {
