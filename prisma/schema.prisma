generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemSetting {
  key       String                  @id
  value     Json
  valueType SettingValueType        @map("value_type")
  version   Int                     @default(1)
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")
  revisions SystemSettingRevision[]

  @@map("system_settings")
}

model SystemSettingRevision {
  id           String           @id @default(cuid())
  settingKey   String           @map("setting_key")
  version      Int
  value        Json
  valueType    SettingValueType @map("value_type")
  changedById  String?          @map("changed_by_id")
  changeReason String?          @map("change_reason")
  createdAt    DateTime         @default(now()) @map("created_at")
  setting      SystemSetting    @relation(fields: [settingKey], references: [key], onDelete: Restrict)
  changedBy    User?            @relation("SystemSettingRevisionChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@unique([settingKey, version])
  @@index([changedById, createdAt])
  @@map("system_setting_revisions")
}

model CompanyCapability {
  code      CapabilityCode              @id
  enabled   Boolean                     @default(false)
  version   Int                         @default(1)
  createdAt DateTime                    @default(now()) @map("created_at")
  updatedAt DateTime                    @updatedAt @map("updated_at")
  revisions CompanyCapabilityRevision[]

  @@map("company_capabilities")
}

model CompanyCapabilityRevision {
  id             String            @id @default(cuid())
  capabilityCode CapabilityCode    @map("capability_code")
  version        Int
  enabled        Boolean
  changedById    String?           @map("changed_by_id")
  changeReason   String?           @map("change_reason")
  createdAt      DateTime          @default(now()) @map("created_at")
  capability     CompanyCapability @relation(fields: [capabilityCode], references: [code], onDelete: Restrict)
  changedBy      User?             @relation("CompanyCapabilityRevisionChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@unique([capabilityCode, version])
  @@index([changedById, createdAt])
  @@map("company_capability_revisions")
}

model OutboxEvent {
  id             String         @id @default(cuid())
  eventType      String         @map("event_type")
  aggregateType  String         @map("aggregate_type")
  aggregateId    String?        @map("aggregate_id")
  payload        Json
  payloadHash    String         @map("payload_hash")
  idempotencyKey String         @map("idempotency_key")
  occurredAt     DateTime       @default(now()) @map("occurred_at")
  dispatchedAt   DateTime?      @map("dispatched_at")
  job            PersistentJob?

  @@unique([eventType, idempotencyKey])
  @@index([dispatchedAt, occurredAt])
  @@map("outbox_events")
}

model PersistentJob {
  id                  String       @id @default(cuid())
  sourceOutboxEventId String?      @unique @map("source_outbox_event_id")
  jobType             String       @map("job_type")
  payload             Json
  payloadHash         String       @map("payload_hash")
  idempotencyKey      String       @map("idempotency_key")
  status              JobStatus    @default(PENDING)
  maxAttempts         Int          @map("max_attempts")
  attemptCount        Int          @default(0) @map("attempt_count")
  cycleAttemptCount   Int          @default(0) @map("cycle_attempt_count")
  nextRunAt           DateTime     @default(now()) @map("next_run_at")
  lockedAt            DateTime?    @map("locked_at")
  lockedBy            String?      @map("locked_by")
  leaseExpiresAt      DateTime?    @map("lease_expires_at")
  lastErrorCode       String?      @map("last_error_code")
  lastErrorMessage    String?      @map("last_error_message")
  completedAt         DateTime?    @map("completed_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  sourceOutboxEvent   OutboxEvent? @relation(fields: [sourceOutboxEventId], references: [id], onDelete: Restrict)
  attempts            JobAttempt[]

  @@unique([jobType, idempotencyKey])
  @@index([status, nextRunAt])
  @@index([status, leaseExpiresAt])
  @@map("persistent_jobs")
}

model JobAttempt {
  id            String           @id @default(cuid())
  jobId         String           @map("job_id")
  attemptNumber Int              @map("attempt_number")
  status        JobAttemptStatus @default(QUEUED)
  availableAt   DateTime         @default(now()) @map("available_at")
  startedAt     DateTime?        @map("started_at")
  completedAt   DateTime?        @map("completed_at")
  workerId      String?          @map("worker_id")
  errorCode     String?          @map("error_code")
  errorMessage  String?          @map("error_message")
  isReplay      Boolean          @default(false) @map("is_replay")
  requestedById String?          @map("requested_by_id")
  replayReason  String?          @map("replay_reason")
  createdAt     DateTime         @default(now()) @map("created_at")
  job           PersistentJob    @relation(fields: [jobId], references: [id], onDelete: Restrict)
  requestedBy   User?            @relation("JobAttemptRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@unique([jobId, attemptNumber])
  @@index([status, availableAt])
  @@index([requestedById, createdAt])
  @@map("job_attempts")
}

enum SettingValueType {
  BOOLEAN
  INTEGER
  STRING
  JSON
}

enum CapabilityCode {
  SUPPLIER_COLLABORATION
  CUSTOMER_PROGRESS_SHARING
  AI_ISSUE_INTAKE
  UPH_ANALYSIS
  INCENTIVE_MANAGEMENT
}

enum JobStatus {
  PENDING
  RUNNING
  RETRY_SCHEDULED
  SUCCEEDED
  DEAD_LETTER
}

enum JobAttemptStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PermissionScope {
  ALL
  DEPARTMENT
  PROJECT
  SELF
  ASSIGNED
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  GATE_REVIEW
  SUSPENDED
  CLOSED
  CANCELED
}

enum ProjectRole {
  PROJECT_MANAGER
  DEPARTMENT_LEAD
  ENGINEER
  PROCUREMENT
  QUALITY
  VIEWER
}

enum AuditAction {
  AUTHORIZATION_DENIED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_ENDED
  AUDIT_LOG_READ
  CONFIGURATION_SETTING_CHANGED
  COMPANY_CAPABILITY_CHANGED
  JOB_REPLAYED
}

enum AuditObjectType {
  PROJECT
  PROJECT_MEMBER
  AUDIT_LOG
  SYSTEM_SETTING
  COMPANY_CAPABILITY
  OUTBOX_EVENT
  PERSISTENT_JOB
}

enum AuditSource {
  API
  WORKER
  SCHEDULER
  SYSTEM
  INTEGRATION
  EXTERNAL_API
}

enum AuditResult {
  SUCCESS
  DENIED
  FAILURE
}

model User {
  id                  String                      @id @default(cuid())
  employeeNo          String                      @unique @map("employee_no")
  name                String
  email               String?                     @unique
  departmentId        String?                     @map("department_id")
  status              UserStatus                  @default(ACTIVE)
  version             Int                         @default(1)
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")
  roleAssignments     UserRole[]                  @relation("RoleAssignmentUser")
  rolesAssigned       UserRole[]                  @relation("RoleAssignmentActor")
  memberships         ProjectMember[]             @relation("ProjectMemberUser")
  membershipsAssigned ProjectMember[]             @relation("ProjectMemberAssignedBy")
  membershipsEnded    ProjectMember[]             @relation("ProjectMemberLeftBy")
  projectsCreated     Project[]                   @relation("ProjectCreatedBy")
  auditLogs           AuditLog[]
  settingRevisions    SystemSettingRevision[]     @relation("SystemSettingRevisionChangedBy")
  capabilityRevisions CompanyCapabilityRevision[] @relation("CompanyCapabilityRevisionChangedBy")
  requestedJobReplays JobAttempt[]                @relation("JobAttemptRequestedBy")

  @@index([departmentId])
  @@map("users")
}

model Role {
  id          String           @id
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(true) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id
  code        String           @unique
  description String
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String          @map("role_id")
  permissionId String          @map("permission_id")
  scope        PermissionScope
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  roleId       String    @map("role_id")
  assignedById String?   @map("assigned_by_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  revokedAt    DateTime? @map("revoked_at")
  user         User      @relation("RoleAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy   User?     @relation("RoleAssignmentActor", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([roleId])
  @@map("user_roles")
}

// APM-011 will extend this project shell with the template snapshot and lifecycle fields.
model Project {
  id           String          @id @default(cuid())
  code         String          @unique
  name         String
  departmentId String?         @map("department_id")
  status       ProjectStatus   @default(DRAFT)
  version      Int             @default(1)
  createdById  String          @map("created_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  createdBy    User            @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  members      ProjectMember[]
  auditLogs    AuditLog[]

  @@index([departmentId])
  @@map("projects")
}

model ProjectMember {
  id           String      @id @default(cuid())
  projectId    String      @map("project_id")
  userId       String      @map("user_id")
  projectRole  ProjectRole @map("project_role")
  departmentId String?     @map("department_id")
  assignedById String      @map("assigned_by_id")
  joinedAt     DateTime    @default(now()) @map("joined_at")
  leftAt       DateTime?   @map("left_at")
  leftById     String?     @map("left_by_id")
  version      Int         @default(1)
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user         User        @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy   User        @relation("ProjectMemberAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  leftBy       User?       @relation("ProjectMemberLeftBy", fields: [leftById], references: [id], onDelete: Restrict)

  @@index([projectId, leftAt])
  @@index([userId, leftAt])
  @@map("project_members")
}

model AuditLog {
  id           String          @id @default(cuid())
  actorId      String?         @map("actor_id")
  action       AuditAction
  objectType   AuditObjectType @map("object_type")
  objectId     String?         @map("object_id")
  projectId    String?         @map("project_id")
  departmentId String?         @map("department_id")
  requestId    String?         @map("request_id")
  traceId      String?         @map("trace_id")
  operationId  String?         @map("operation_id")
  beforeJson   Json?           @map("before_json")
  afterJson    Json?           @map("after_json")
  metadataJson Json?           @map("metadata_json")
  source       AuditSource
  sourceIp     String?         @map("source_ip")
  userAgent    String?         @map("user_agent")
  reason       String?
  result       AuditResult     @default(SUCCESS)
  occurredAt   DateTime        @default(now()) @map("occurred_at")
  actor        User?           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([actorId, occurredAt])
  @@index([objectType, objectId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([departmentId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}
