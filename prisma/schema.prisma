  @@unique([revisionId, fileObjectId])
  @@index([projectId, revisionId])
  @@map("project_uph_test_batch_revision_evidence")
}

model ProjectUphAnalysisSnapshot {
  id                 String                    @id @default(cuid())
  projectId          String                    @map("project_id")
  batchId            String                    @map("batch_id")
  revisionId         String                    @map("revision_id")
  lockedChecksum     String                    @map("locked_checksum")
  formulaVersionId   String                    @map("formula_version_id")
  formulaChecksum    String                    @map("formula_checksum")
  engineCode         String                    @map("engine_code")
  inputSnapshotJson  Json                      @map("input_snapshot_json")
  inputChecksum      String                    @map("input_checksum")
  resultSnapshotJson Json                      @map("result_snapshot_json")
  resultChecksum     String                    @map("result_checksum")
  status             UphAnalysisSnapshotStatus
  warningsJson       Json                      @map("warnings_json")
  rootCapacityUph    Decimal                   @map("root_capacity_uph") @db.Decimal(20, 6)
  actualGoodUph      Decimal                   @map("actual_good_uph") @db.Decimal(20, 6)
  utilizationA       Decimal                   @map("utilization_a") @db.Decimal(20, 6)
  resourceVersion    Int                       @default(1) @map("resource_version")
  createdById        String                    @map("created_by_id")
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3) @map("created_at")
  project            Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  batch              ProjectUphTestBatch       @relation("UphAnalysisSnapshotBatch", fields: [batchId, projectId], references: [id, projectId], onDelete: Restrict)
  revision           ProjectUphTestBatchRevision @relation("UphAnalysisSnapshotRevision", fields: [revisionId, projectId], references: [id, projectId], onDelete: Restrict)
  formulaVersion     ProjectUphFormulaVersion  @relation("UphAnalysisSnapshotFormulaVersion", fields: [formulaVersionId, projectId], references: [id, projectId], onDelete: Restrict)
  createdBy          User                      @relation("UphAnalysisSnapshotCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([projectId, revisionId, lockedChecksum, engineCode])
  @@unique([id, projectId])
  @@index([projectId, batchId, revisionId])
  @@map("project_uph_analysis_snapshots")
}

model ProjectUphPerformanceTarget {
  id                        String                               @id @default(cuid())
  projectId                 String                               @map("project_id")
  topologyRootNodeId        String                               @map("topology_root_node_id")
  currentPublishedVersionId String?                              @map("current_published_version_id")
  version                   Int                                  @default(1)
  createdById               String                               @map("created_by_id")
  createdAt                 DateTime                             @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt                 DateTime                             @updatedAt @db.Timestamptz(3) @map("updated_at")
  project                   Project                              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  currentPublished          ProjectUphPerformanceTargetVersion?  @relation("UphTargetCurrentPublished", fields: [currentPublishedVersionId, projectId], references: [id, projectId], onDelete: Restrict)
  versions                  ProjectUphPerformanceTargetVersion[] @relation("UphTargetVersions")
  createdBy                 User                                 @relation("UphPerformanceTargetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([projectId, topologyRootNodeId])
  @@unique([id, projectId])
  @@unique([currentPublishedVersionId, projectId])
  @@map("project_uph_performance_targets")
}

model ProjectUphPerformanceTargetVersion {
  id              String                       @id @default(cuid())
  projectId       String                       @map("project_id")
  targetId        String                       @map("target_id")
  revision        Int
  status          UphVersionStatus
  targetUph       Decimal                      @map("target_uph") @db.Decimal(20, 6)
  reason          String
  checksum        String
  effectiveAt     DateTime                     @db.Timestamptz(3) @map("effective_at")
  resourceVersion Int                          @default(1) @map("resource_version")
  createdById     String                       @map("created_by_id")
  publishedById   String?                      @map("published_by_id")
  publishedAt     DateTime?                    @db.Timestamptz(3) @map("published_at")
  createdAt       DateTime                     @default(now()) @db.Timestamptz(3) @map("created_at")
  project         Project                      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  target          ProjectUphPerformanceTarget  @relation("UphTargetVersions", fields: [targetId, projectId], references: [id, projectId], onDelete: Restrict)
  currentFor      ProjectUphPerformanceTarget? @relation("UphTargetCurrentPublished")
  createdBy       User                         @relation("UphPerformanceTargetVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy     User?                        @relation("UphPerformanceTargetVersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)

  @@unique([id, projectId])
  @@unique([targetId, revision])
  @@index([projectId, targetId, effectiveAt])
  @@index([projectId, status, effectiveAt])
  @@map("project_uph_performance_target_versions")
}

model ProjectMember {
  id                              String                              @id @default(cuid())
  projectId                       String                              @map("project_id")
  userId                          String                              @map("user_id")
  projectRole                     ProjectRole                         @map("project_role")
  departmentId                    String?                             @map("department_id")
  assignedById                    String                              @map("assigned_by_id")
  joinedAt                        DateTime                            @default(now()) @map("joined_at")
  leftAt                          DateTime?                           @map("left_at")
  leftById                        String?                             @map("left_by_id")
  version                         Int                                 @default(1)
  project                         Project                             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user                            User                                @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy                      User                                @relation("ProjectMemberAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  leftBy                          User?                               @relation("ProjectMemberLeftBy", fields: [leftById], references: [id], onDelete: Restrict)
  ownedResponsibilityPackages     ResponsibilityPackage[]
  assignedPlanningTasks           PlanningTask[]
  resourceLoadPersonProjections   ResourceLoadPersonProjection[]
  ownedIssues                     Issue[]                             @relation("IssueOwnerMembership")
  verifiedIssues                  Issue[]                             @relation("IssueVerifierMembership")
  ownedResidualItems              ResidualItem[]                      @relation("ResidualItemOwnerMembership")
  verifiedResidualItems           ResidualItem[]                      @relation("ResidualItemVerifierMembership")
  procurementTrackingLines        ProcurementTrackingLine[]
  retrospectiveContributions      ProjectRetrospectiveContribution[]  @relation("RetrospectiveContributionMember")
  retrospectiveParticipants       ProjectRetrospectiveParticipant[]   @relation("RetrospectiveParticipantMember")
  knowledgeReuseConfirmations     KnowledgeReuseRecord[]              @relation("KnowledgeReuseConfirmedBy")
  ownedAssetProjectImpacts        AssetProjectImpact[]                @relation("AssetProjectImpactOwnerMembership")
  assetImpactAssessmentActors     AssetImpactAssessmentRevision[]     @relation("AssetImpactAssessmentRevisionActorMembership")
  assetImpactAssessmentOwners     AssetImpactAssessmentRevision[]     @relation("AssetImpactAssessmentRevisionOwnerMembership")
  assetImpactDispositionActors    AssetImpactDisposition[]            @relation("AssetImpactDispositionActorMembership")
  assetImpactDispositionOwners    AssetImpactDisposition[]            @relation("AssetImpactDispositionOwnerMembership")
  assetImpactRiskRequests         AssetImpactRiskAcceptanceRequest[]  @relation("AssetImpactRiskAcceptanceRequestedMembership")
  assetImpactRiskDecisions        AssetImpactRiskAcceptanceDecision[] @relation("AssetImpactRiskAcceptanceDecisionMembership")
  uphTopologyProcessOwnerVersions ProjectUphTopologyVersion[]         @relation("UphTopologyVersionProcessOwnerMembership")
  uphTopologyCommissionedVersions ProjectUphTopologyVersion[]         @relation("UphTopologyVersionCommissioningMembership")
  uphTopologyQualityVersions      ProjectUphTopologyVersion[]         @relation("UphTopologyVersionQualityMembership")
  uphCtProcessOwnerVersions       ProjectUphCtDefinitionVersion[]     @relation("UphCtVersionProcessOwnerMembership")
  uphCtCommissionedVersions       ProjectUphCtDefinitionVersion[]     @relation("UphCtVersionCommissioningMembership")
  uphCtQualityVersions            ProjectUphCtDefinitionVersion[]     @relation("UphCtVersionQualityMembership")
  uphFormulaProcessOwnerVersions  ProjectUphFormulaVersion[]          @relation("UphFormulaVersionProcessOwnerMembership")
  uphFormulaQualityVersions       ProjectUphFormulaVersion[]          @relation("UphFormulaVersionQualityMembership")
  uphTestBatchProcessOwnerRevisions ProjectUphTestBatchRevision[]      @relation("UphTestBatchProcessOwnerMembership")
  uphTestBatchPmConfirmerRevisions ProjectUphTestBatchRevision[]       @relation("UphTestBatchPmConfirmerMembership")
  uphTestBatchQualityLockerRevisions ProjectUphTestBatchRevision[]     @relation("UphTestBatchQualityLockerMembership")
  uphTestBatchCapturedSamples      ProjectUphModuleCycleSample[]      @relation("UphTestBatchSampleCaptureMembership")

  @@unique([id, projectId])
  @@index([projectId, leftAt])
  @@index([userId, leftAt])
  @@map("project_members")
}

model AuditLog {
  id           String          @id @default(cuid())
  actorId      String?         @map("actor_id")
  action       AuditAction
  objectType   AuditObjectType @map("object_type")
  objectId     String?         @map("object_id")
  projectId    String?         @map("project_id")
  departmentId String?         @map("department_id")
  requestId    String?         @map("request_id")
  traceId      String?         @map("trace_id")
  operationId  String?         @map("operation_id")
  beforeJson   Json?           @map("before_json")
  afterJson    Json?           @map("after_json")
  metadataJson Json?           @map("metadata_json")
  source       AuditSource
  sourceIp     String?         @map("source_ip")
  userAgent    String?         @map("user_agent")
  reason       String?
  result       AuditResult     @default(SUCCESS)
  occurredAt   DateTime        @default(now()) @map("occurred_at")
  actor        User?           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([actorId, occurredAt])
  @@index([objectType, objectId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([departmentId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}
