  @@index([projectId, revision])
  @@index([checksum])
  @@map("project_calendar_revisions")
}

model TaskDependency {
  id                String               @id @default(cuid())
  projectId         String               @map("project_id")
  predecessorTaskId String               @map("predecessor_task_id")
  successorTaskId   String               @map("successor_task_id")
  dependencyType    TaskDependencyType   @map("dependency_type")
  lagMinutes        Int                  @default(0) @map("lag_minutes")
  status            TaskDependencyStatus @default(ACTIVE)
  version           Int                  @default(1)
  closedAt          DateTime?            @map("closed_at")
  createdById       String               @map("created_by_id")
  updatedById       String               @map("updated_by_id")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  predecessorTask   PlanningTask         @relation("TaskDependencyPredecessor", fields: [predecessorTaskId, projectId], references: [id, projectId], onDelete: Restrict)
  successorTask     PlanningTask         @relation("TaskDependencySuccessor", fields: [successorTaskId, projectId], references: [id, projectId], onDelete: Restrict)
  createdBy         User                 @relation("TaskDependencyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User                 @relation("TaskDependencyUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([projectId, predecessorTaskId, successorTaskId])
  @@unique([id, projectId])
  @@index([projectId, status, predecessorTaskId])
  @@index([projectId, status, successorTaskId])
  @@map("task_dependencies")
}

model ProjectScheduleState {
  projectId                      String                 @id @map("project_id")
  inputVersion                   Int                    @default(0) @map("input_version")
  latestPublishedInputVersion    Int?                   @map("latest_published_input_version")
  latestPublishedRecalculationId String?                @unique @map("latest_published_recalculation_id")
  updatedAt                      DateTime               @updatedAt @map("updated_at")
  project                        Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  latestPublishedRecalculation   ScheduleRecalculation? @relation("LatestPublishedScheduleRecalculation", fields: [latestPublishedRecalculationId], references: [id], onDelete: Restrict)

  @@index([inputVersion])
  @@map("project_schedule_states")
}

model ScheduleRecalculation {
  id                 String                      @id @default(cuid())
  projectId          String                      @map("project_id")
  inputVersion       Int                         @map("input_version")
  status             ScheduleRecalculationStatus @default(PENDING)
  algorithmVersion   String                      @map("algorithm_version")
  sourceAction       String                      @map("source_action")
  reason             String
  requestedById      String                      @map("requested_by_id")
  calendarRevisionId String?                     @map("calendar_revision_id")
  inputChecksum      String?                     @map("input_checksum")
  inputSnapshot      Json?                       @map("input_snapshot")
  resultChecksum     String?                     @map("result_checksum")
  taskCount          Int?                        @map("task_count")
  dependencyCount    Int?                        @map("dependency_count")
  errorCode          String?                     @map("error_code")
  errorMessage       String?                     @map("error_message")
  requestedAt        DateTime                    @default(now()) @map("requested_at")
  startedAt          DateTime?                   @map("started_at")
  completedAt        DateTime?                   @map("completed_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  project            Project                     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requestedBy        User                        @relation("ScheduleRecalculationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  calendarRevision   ProjectCalendarRevision?    @relation(fields: [calendarRevisionId], references: [id], onDelete: Restrict)
  publishedForState  ProjectScheduleState?       @relation("LatestPublishedScheduleRecalculation")
  taskForecasts      ScheduleTaskForecast[]

  @@unique([projectId, inputVersion])
  @@unique([id, projectId])
  @@index([projectId, status, requestedAt])
  @@index([status, requestedAt])
  @@map("schedule_recalculations")
}

model ScheduleTaskForecast {
  id                String                @id @default(cuid())
  recalculationId   String                @map("recalculation_id")
  projectId         String                @map("project_id")
  taskId            String                @map("task_id")
  position          Int
  durationMinutes   Int                   @map("duration_minutes")
  predictedStartAt  DateTime              @map("predicted_start_at")
  predictedFinishAt DateTime              @map("predicted_finish_at")
  latestStartAt     DateTime              @map("latest_start_at")
  latestFinishAt    DateTime              @map("latest_finish_at")
  totalFloatMinutes Int                   @map("total_float_minutes")
  isCritical        Boolean               @map("is_critical")
  createdAt         DateTime              @default(now()) @map("created_at")
  recalculation     ScheduleRecalculation @relation(fields: [recalculationId, projectId], references: [id, projectId], onDelete: Restrict)
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task              PlanningTask          @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict)

  @@unique([recalculationId, taskId])
  @@index([projectId, isCritical, position])
  @@index([projectId, taskId, createdAt])
  @@map("schedule_task_forecasts")
}

model ProjectMember {
  id                          String                  @id @default(cuid())
  projectId                   String                  @map("project_id")
  userId                      String                  @map("user_id")
  projectRole                 ProjectRole             @map("project_role")
  departmentId                String?                 @map("department_id")
  assignedById                String                  @map("assigned_by_id")
  joinedAt                    DateTime                @default(now()) @map("joined_at")
  leftAt                      DateTime?               @map("left_at")
  leftById                    String?                 @map("left_by_id")
  version                     Int                     @default(1)
  project                     Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user                        User                    @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy                  User                    @relation("ProjectMemberAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  leftBy                      User?                   @relation("ProjectMemberLeftBy", fields: [leftById], references: [id], onDelete: Restrict)
  ownedResponsibilityPackages ResponsibilityPackage[]
  assignedPlanningTasks       PlanningTask[]

  @@unique([id, projectId])
  @@index([projectId, leftAt])
  @@index([userId, leftAt])
  @@map("project_members")
}

model AuditLog {
  id           String          @id @default(cuid())
  actorId      String?         @map("actor_id")
  action       AuditAction
  objectType   AuditObjectType @map("object_type")
  objectId     String?         @map("object_id")
  projectId    String?         @map("project_id")
  departmentId String?         @map("department_id")
  requestId    String?         @map("request_id")
  traceId      String?         @map("trace_id")
  operationId  String?         @map("operation_id")
  beforeJson   Json?           @map("before_json")
  afterJson    Json?           @map("after_json")
  metadataJson Json?           @map("metadata_json")
  source       AuditSource
  sourceIp     String?         @map("source_ip")
  userAgent    String?         @map("user_agent")
  reason       String?
  result       AuditResult     @default(SUCCESS)
  occurredAt   DateTime        @default(now()) @map("occurred_at")
  actor        User?           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([actorId, occurredAt])
  @@index([objectType, objectId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([departmentId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}
