  RESPONSIBILITY_PACKAGE_ACCEPTED
  RESPONSIBILITY_PACKAGE_REOPENED
  RESPONSIBILITY_PACKAGE_CLOSED
  WBS_NODE_CREATED
  WBS_NODE_UPDATED
