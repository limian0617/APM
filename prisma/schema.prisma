  SUCCEEDED
  FAILED
  SUPERSEDED
}

enum ProjectRole {
  PROJECT_MANAGER
  DEPARTMENT_LEAD
  ENGINEER
  PROCUREMENT
  QUALITY
  VIEWER
}

