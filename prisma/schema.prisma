  TASK_DEPENDENCY_CLOSED
}

enum AuditObjectType {
  PROJECT
  PROJECT_MEMBER
  AUDIT_LOG
  SYSTEM_SETTING
  COMPANY_CAPABILITY
  OUTBOX_EVENT
  PERSISTENT_JOB
  FILE_OBJECT
  FILE_UPLOAD_SESSION
  NOTIFICATION_TEMPLATE
  NOTIFICATION
  NOTIFICATION_DELIVERY
  TEMPLATE_COMPONENT
  TEMPLATE
  TEMPLATE_VERSION
  DELIVERY_UNIT
  PROJECT_MODULE
  PROJECT_CAPABILITY
  RESPONSIBILITY_PACKAGE
  WBS_NODE
  PLANNING_TASK
  PROJECT_CALENDAR
  TASK_DEPENDENCY
}

enum AuditSource {
  API
  WORKER
  SCHEDULER
  SYSTEM
  INTEGRATION
  EXTERNAL_API
}

enum AuditResult {
  SUCCESS
  DENIED
  FAILURE
}

model User {
  id                                    String                        @id @default(cuid())
  employeeNo                            String                        @unique @map("employee_no")
  name                                  String
  email                                 String?                       @unique
  departmentId                          String?                       @map("department_id")
  status                                UserStatus                    @default(ACTIVE)
  version                               Int                           @default(1)
  createdAt                             DateTime                      @default(now()) @map("created_at")
  updatedAt                             DateTime                      @updatedAt @map("updated_at")
  roleAssignments                       UserRole[]                    @relation("RoleAssignmentUser")
  rolesAssigned                         UserRole[]                    @relation("RoleAssignmentActor")
  memberships                           ProjectMember[]               @relation("ProjectMemberUser")
  membershipsAssigned                   ProjectMember[]               @relation("ProjectMemberAssignedBy")
  membershipsEnded                      ProjectMember[]               @relation("ProjectMemberLeftBy")
  projectsCreated                       Project[]                     @relation("ProjectCreatedBy")
  auditLogs                             AuditLog[]
  settingRevisions                      SystemSettingRevision[]       @relation("SystemSettingRevisionChangedBy")
  capabilityRevisions                   CompanyCapabilityRevision[]   @relation("CompanyCapabilityRevisionChangedBy")
  requestedJobReplays                   JobAttempt[]                  @relation("JobAttemptRequestedBy")
  filesUploaded                         FileObject[]                  @relation("FileObjectUploadedBy")
  fileCommands                          FileCommand[]                 @relation("FileCommandActor")
  notificationTemplateVersionsPublished NotificationTemplateVersion[] @relation("NotificationTemplatePublishedBy")
  notificationsReceived                 Notification[]                @relation("NotificationRecipient")
  notificationReadReceipts              NotificationReadReceipt[]     @relation("NotificationReadRecipient")
  apiIdempotencyRecords                 ApiIdempotencyRecord[]
  templateComponentsCreated             TemplateComponent[]           @relation("TemplateComponentCreatedBy")
  templateComponentsUpdated             TemplateComponent[]           @relation("TemplateComponentUpdatedBy")
  templateComponentVersionsPublished    TemplateComponentVersion[]    @relation("TemplateComponentVersionPublishedBy")
  projectTemplatesCreated               ProjectTemplate[]             @relation("ProjectTemplateCreatedBy")
  projectTemplatesUpdated               ProjectTemplate[]             @relation("ProjectTemplateUpdatedBy")
  projectTemplateVersionsPublished      ProjectTemplateVersion[]      @relation("ProjectTemplateVersionPublishedBy")
  deliveryUnitsCreated                  DeliveryUnit[]                @relation("DeliveryUnitCreatedBy")
  deliveryUnitsUpdated                  DeliveryUnit[]                @relation("DeliveryUnitUpdatedBy")
  projectModulesCreated                 ProjectModule[]               @relation("ProjectModuleCreatedBy")
  projectModulesUpdated                 ProjectModule[]               @relation("ProjectModuleUpdatedBy")
  projectCapabilitiesCreated            ProjectCapability[]           @relation("ProjectCapabilityCreatedBy")
  projectCapabilitiesUpdated            ProjectCapability[]           @relation("ProjectCapabilityUpdatedBy")
  projectCapabilityRevisionsChanged     ProjectCapabilityRevision[]   @relation("ProjectCapabilityRevisionChangedBy")
  responsibilityPackagesCreated         ResponsibilityPackage[]       @relation("ResponsibilityPackageCreatedBy")
  responsibilityPackagesUpdated         ResponsibilityPackage[]       @relation("ResponsibilityPackageUpdatedBy")
  responsibilityPackageEventsActed      ResponsibilityPackageEvent[]  @relation("ResponsibilityPackageEventActor")
  wbsNodesCreated                       WbsNode[]                     @relation("WbsNodeCreatedBy")
  wbsNodesUpdated                       WbsNode[]                     @relation("WbsNodeUpdatedBy")
  planningTasksCreated                  PlanningTask[]                @relation("PlanningTaskCreatedBy")
  planningTasksUpdated                  PlanningTask[]                @relation("PlanningTaskUpdatedBy")
  projectCalendarsCreated               ProjectCalendar[]             @relation("ProjectCalendarCreatedBy")
  projectCalendarsUpdated               ProjectCalendar[]             @relation("ProjectCalendarUpdatedBy")
  projectCalendarRevisionsCreated       ProjectCalendarRevision[]     @relation("ProjectCalendarRevisionCreatedBy")
  taskDependenciesCreated               TaskDependency[]              @relation("TaskDependencyCreatedBy")
  taskDependenciesUpdated               TaskDependency[]              @relation("TaskDependencyUpdatedBy")
  scheduleRecalculationsRequested       ScheduleRecalculation[]       @relation("ScheduleRecalculationRequestedBy")

  @@index([departmentId])
  @@map("users")
}

model Role {
  id          String           @id
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(true) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id
  code        String           @unique
  description String
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String          @map("role_id")
  permissionId String          @map("permission_id")
  scope        PermissionScope
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  roleId       String    @map("role_id")
  assignedById String?   @map("assigned_by_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  revokedAt    DateTime? @map("revoked_at")
  user         User      @relation("RoleAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy   User?     @relation("RoleAssignmentActor", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([roleId])
  @@map("user_roles")
}

model Project {
  id                            String                               @id @default(cuid())
  code                          String                               @unique
  name                          String
  departmentId                  String?                              @map("department_id")
  status                        ProjectStatus                        @default(DRAFT)
  initializationStatus          ProjectInitializationStatus          @default(LEGACY) @map("initialization_status")
  projectType                   ProjectType                          @default(LEGACY) @map("project_type")
  equipmentShape                EquipmentShape?                      @map("equipment_shape")
  structureStatus               ProjectStructureStatus               @default(UNCONFIGURED) @map("structure_status")
  capabilityConfigurationStatus ProjectCapabilityConfigurationStatus @default(UNCONFIGURED) @map("capability_configuration_status")
  capabilitiesConfiguredAt      DateTime?                            @map("capabilities_configured_at")
  sourceTemplateVersionId       String?                              @map("source_template_version_id")
  sourceTemplateChecksum        String?                              @map("source_template_checksum")
  initializedAt                 DateTime?                            @map("initialized_at")
  version                       Int                                  @default(1)
  createdById                   String                               @map("created_by_id")
  createdAt                     DateTime                             @default(now()) @map("created_at")
  updatedAt                     DateTime                             @updatedAt @map("updated_at")
  createdBy                     User                                 @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sourceTemplateVersion         ProjectTemplateVersion?              @relation("ProjectSourceTemplateVersion", fields: [sourceTemplateVersionId], references: [id], onDelete: Restrict)
  templateSnapshot              ProjectTemplateSnapshot?
  members                       ProjectMember[]
  auditLogs                     AuditLog[]
  files                         FileObject[]
  notifications                 Notification[]
  deliveryUnits                 DeliveryUnit[]
  projectModules                ProjectModule[]
  projectCapabilities           ProjectCapability[]
  responsibilityPackages        ResponsibilityPackage[]
  wbsNodes                      WbsNode[]
  planningTasks                 PlanningTask[]
  planningCalendar              ProjectCalendar?
  projectCalendarRevisions      ProjectCalendarRevision[]
  taskDependencies              TaskDependency[]
  scheduleState                 ProjectScheduleState?
  scheduleRecalculations        ScheduleRecalculation[]
  scheduleTaskForecasts         ScheduleTaskForecast[]

  @@index([departmentId])
  @@index([sourceTemplateVersionId])
  @@index([initializationStatus, createdAt])
  @@index([projectType, equipmentShape, structureStatus])
  @@index([capabilityConfigurationStatus, createdAt])
  @@map("projects")
}

model ProjectTemplateSnapshot {
  id                      String                             @id @default(cuid())
  projectId               String                             @unique @map("project_id")
  sourceTemplateVersionId String                             @map("source_template_version_id")
  sourceTemplateChecksum  String                             @map("source_template_checksum")
  snapshotChecksum        String                             @map("snapshot_checksum")
  templateCode            String                             @map("template_code")
  templateName            String                             @map("template_name")
  templateVersion         Int                                @map("template_version")
  templatePublishedAt     DateTime                           @map("template_published_at")
  createdAt               DateTime                           @default(now()) @map("created_at")
  project                 Project                            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sourceTemplateVersion   ProjectTemplateVersion             @relation("ProjectSnapshotSourceTemplateVersion", fields: [sourceTemplateVersionId], references: [id], onDelete: Restrict)
  components              ProjectTemplateSnapshotComponent[]

  @@index([sourceTemplateVersionId, createdAt])
  @@map("project_template_snapshots")
}

model ProjectTemplateSnapshotComponent {
  id                       String                   @id @default(cuid())
  snapshotId               String                   @map("snapshot_id")
  sourceComponentVersionId String                   @map("source_component_version_id")
  componentType            TemplateComponentType    @map("component_type")
  slot                     String
  position                 Int
  sourceChecksum           String                   @map("source_checksum")
  componentCode            String                   @map("component_code")
  componentName            String                   @map("component_name")
  componentVersion         Int                      @map("component_version")
  description              String?
  contentJson              Json                     @map("content_json")
  snapshot                 ProjectTemplateSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  sourceComponentVersion   TemplateComponentVersion @relation(fields: [sourceComponentVersionId], references: [id], onDelete: Restrict)
  projectCapabilities      ProjectCapability[]

  @@unique([snapshotId, slot])
  @@unique([snapshotId, position])
  @@index([sourceComponentVersionId])
  @@map("project_template_snapshot_components")
}

model DeliveryUnit {
  id                     String                     @id @default(cuid())
  projectId              String                     @map("project_id")
  parentId               String?                    @map("parent_id")
  unitType               DeliveryUnitType           @map("unit_type")
  code                   String
  name                   String
  status                 ProjectStructureNodeStatus @default(ACTIVE)
  position               Int
  version                Int                        @default(1)
  createdById            String                     @map("created_by_id")
  updatedById            String                     @map("updated_by_id")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")
  project                Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  parent                 DeliveryUnit?              @relation("DeliveryUnitHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children               DeliveryUnit[]             @relation("DeliveryUnitHierarchy")
  modules                ProjectModule[]
  responsibilityPackages ResponsibilityPackage[]
  planningTasks          PlanningTask[]
  createdBy              User                       @relation("DeliveryUnitCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy              User                       @relation("DeliveryUnitUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([projectId, code])
  @@unique([id, projectId])
  @@unique([projectId, parentId, position])
  @@index([projectId, unitType, status])
  @@index([parentId, position])
  @@map("delivery_units")
}

model ProjectModule {
  id                     String                     @id @default(cuid())
  projectId              String                     @map("project_id")
  deliveryUnitId         String                     @map("delivery_unit_id")
  code                   String
  name                   String
  status                 ProjectStructureNodeStatus @default(ACTIVE)
  position               Int
  version                Int                        @default(1)
  createdById            String                     @map("created_by_id")
  updatedById            String                     @map("updated_by_id")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")
  project                Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  deliveryUnit           DeliveryUnit               @relation(fields: [deliveryUnitId], references: [id], onDelete: Restrict)
  createdBy              User                       @relation("ProjectModuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy              User                       @relation("ProjectModuleUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  responsibilityPackages ResponsibilityPackage[]
  planningTasks          PlanningTask[]

  @@unique([projectId, code])
  @@unique([id, projectId])
  @@unique([deliveryUnitId, position])
  @@index([projectId, status])
  @@index([deliveryUnitId, status])
  @@map("project_modules")
}

model ProjectCapability {
  projectId                 String                            @map("project_id")
  capabilityCode            CapabilityCode                    @map("capability_code")
  templateAllowed           Boolean                           @map("template_allowed")
  templateRequired          Boolean                           @map("template_required")
  selectedEnabled           Boolean                           @map("selected_enabled")
  sourceSnapshotComponentId String?                           @map("source_snapshot_component_id")
  version                   Int                               @default(1)
  createdById               String                            @map("created_by_id")
  updatedById               String                            @map("updated_by_id")
  createdAt                 DateTime                          @default(now()) @map("created_at")
  updatedAt                 DateTime                          @updatedAt @map("updated_at")
  project                   Project                           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  companyCapability         CompanyCapability                 @relation(fields: [capabilityCode], references: [code], onDelete: Restrict)
  sourceSnapshotComponent   ProjectTemplateSnapshotComponent? @relation(fields: [sourceSnapshotComponentId], references: [id], onDelete: Restrict)
  createdBy                 User                              @relation("ProjectCapabilityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                 User                              @relation("ProjectCapabilityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  revisions                 ProjectCapabilityRevision[]

  @@id([projectId, capabilityCode])
  @@index([capabilityCode, selectedEnabled])
  @@index([sourceSnapshotComponentId])
  @@map("project_capabilities")
}

model ProjectCapabilityRevision {
  id                        String                    @id @default(cuid())
  projectId                 String                    @map("project_id")
  capabilityCode            CapabilityCode            @map("capability_code")
  version                   Int
  templateAllowed           Boolean                   @map("template_allowed")
  templateRequired          Boolean                   @map("template_required")
  selectedEnabled           Boolean                   @map("selected_enabled")
  sourceSnapshotComponentId String?                   @map("source_snapshot_component_id")
  companyEnabled            Boolean                   @map("company_enabled")
  companyVersion            Int                       @map("company_version")
  effectiveEnabled          Boolean                   @map("effective_enabled")
  changedById               String                    @map("changed_by_id")
  changeReason              String                    @map("change_reason")
  createdAt                 DateTime                  @default(now()) @map("created_at")
  capability                ProjectCapability         @relation(fields: [projectId, capabilityCode], references: [projectId, capabilityCode], onDelete: Restrict)
  companyRevision           CompanyCapabilityRevision @relation("ProjectCapabilityCompanyRevision", fields: [capabilityCode, companyVersion], references: [capabilityCode, version], onDelete: Restrict)
  changedBy                 User                      @relation("ProjectCapabilityRevisionChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@unique([projectId, capabilityCode, version])
  @@index([changedById, createdAt])
  @@index([projectId, createdAt])
  @@map("project_capability_revisions")
}

model ResponsibilityPackage {
  id                     String                       @id @default(cuid())
  projectId              String                       @map("project_id")
  deliveryUnitId         String?                      @map("delivery_unit_id")
  moduleId               String?                      @map("module_id")
  code                   String
  name                   String
  description            String?
  ownerMembershipId      String                       @map("owner_membership_id")
  inputsJson             Json                         @map("inputs_json")
  outputsJson            Json                         @map("outputs_json")
  acceptanceCriteriaJson Json                         @map("acceptance_criteria_json")
  valueWeight            Int                          @map("value_weight")
  status                 ResponsibilityPackageStatus  @default(OPEN)
  acceptanceCycle        Int                          @default(0) @map("acceptance_cycle")
  transitionSequence     Int                          @default(1) @map("transition_sequence")
  acceptedAt             DateTime?                    @map("accepted_at")
  closedAt               DateTime?                    @map("closed_at")
  version                Int                          @default(1)
  createdById            String                       @map("created_by_id")
  updatedById            String                       @map("updated_by_id")
  createdAt              DateTime                     @default(now()) @map("created_at")
  updatedAt              DateTime                     @updatedAt @map("updated_at")
  project                Project                      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  deliveryUnit           DeliveryUnit?                @relation(fields: [deliveryUnitId, projectId], references: [id, projectId], onDelete: Restrict)
  module                 ProjectModule?               @relation(fields: [moduleId, projectId], references: [id, projectId], onDelete: Restrict)
  ownerMembership        ProjectMember                @relation(fields: [ownerMembershipId], references: [id], onDelete: Restrict)
  createdBy              User                         @relation("ResponsibilityPackageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy              User                         @relation("ResponsibilityPackageUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  events                 ResponsibilityPackageEvent[]
  planningTasks          PlanningTask[]

  @@unique([projectId, code])
  @@unique([id, projectId])
  @@index([projectId, status, code])
  @@index([ownerMembershipId, status])
  @@index([deliveryUnitId, status])
  @@index([moduleId, status])
  @@map("responsibility_packages")
}

model ResponsibilityPackageEvent {
  id                    String                         @id @default(cuid())
  packageId             String                         @map("package_id")
  projectId             String                         @map("project_id")
  sequence              Int
  acceptanceCycle       Int                            @map("acceptance_cycle")
  eventType             ResponsibilityPackageEventType @map("event_type")
  fromStatus            ResponsibilityPackageStatus?   @map("from_status")
  toStatus              ResponsibilityPackageStatus    @map("to_status")
  resourceVersion       Int                            @map("resource_version")
  reason                String
  snapshotJson          Json                           @map("snapshot_json")
  actorId               String                         @map("actor_id")
  createdAt             DateTime                       @default(now()) @map("created_at")
  responsibilityPackage ResponsibilityPackage          @relation(fields: [packageId, projectId], references: [id, projectId], onDelete: Restrict)
  actor                 User                           @relation("ResponsibilityPackageEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([packageId, sequence])
  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
  @@map("responsibility_package_events")
}

model WbsNode {
  id          String             @id @default(cuid())
  projectId   String             @map("project_id")
  parentId    String?            @map("parent_id")
  code        String
  name        String
  description String?
  position    Int
  status      PlanningNodeStatus @default(ACTIVE)
  version     Int                @default(1)
  closedAt    DateTime?          @map("closed_at")
  createdById String             @map("created_by_id")
  updatedById String             @map("updated_by_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  parent      WbsNode?           @relation("WbsNodeHierarchy", fields: [parentId, projectId], references: [id, projectId], onDelete: Restrict)
  children    WbsNode[]          @relation("WbsNodeHierarchy")
  tasks       PlanningTask[]
  createdBy   User               @relation("WbsNodeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User               @relation("WbsNodeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([projectId, code])
  @@unique([id, projectId])
  @@unique([projectId, parentId, position])
  @@index([projectId, status, position])
  @@index([parentId, position])
  @@map("wbs_nodes")
}

model PlanningTask {
  id                       String                 @id @default(cuid())
  projectId                String                 @map("project_id")
  wbsNodeId                String                 @map("wbs_node_id")
  responsibilityPackageId  String?                @map("responsibility_package_id")
  deliveryUnitId           String?                @map("delivery_unit_id")
  moduleId                 String?                @map("module_id")
  ownerMembershipId        String                 @map("owner_membership_id")
  code                     String
  name                     String
  description              String?
  position                 Int
  plannedStartAt           DateTime               @map("planned_start_at")
  plannedFinishAt          DateTime               @map("planned_finish_at")
  plannedDurationMinutes   Int                    @map("planned_duration_minutes")
  weight                   Int
  status                   PlanningTaskStatus     @default(NOT_STARTED)
  actualStartAt            DateTime?              @map("actual_start_at")
  actualFinishAt           DateTime?              @map("actual_finish_at")
  remainingDurationMinutes Int                    @map("remaining_duration_minutes")
  forecastFinishAt         DateTime               @map("forecast_finish_at")
  version                  Int                    @default(1)
  closedAt                 DateTime?              @map("closed_at")
  createdById              String                 @map("created_by_id")
  updatedById              String                 @map("updated_by_id")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
  project                  Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  wbsNode                  WbsNode                @relation(fields: [wbsNodeId, projectId], references: [id, projectId], onDelete: Restrict)
  responsibilityPackage    ResponsibilityPackage? @relation(fields: [responsibilityPackageId, projectId], references: [id, projectId], onDelete: Restrict)
  deliveryUnit             DeliveryUnit?          @relation(fields: [deliveryUnitId, projectId], references: [id, projectId], onDelete: Restrict)
  module                   ProjectModule?         @relation(fields: [moduleId, projectId], references: [id, projectId], onDelete: Restrict)
  ownerMembership          ProjectMember          @relation(fields: [ownerMembershipId, projectId], references: [id, projectId], onDelete: Restrict)
  createdBy                User                   @relation("PlanningTaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                User                   @relation("PlanningTaskUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  predecessorDependencies  TaskDependency[]       @relation("TaskDependencyPredecessor")
  successorDependencies    TaskDependency[]       @relation("TaskDependencySuccessor")
  scheduleForecasts        ScheduleTaskForecast[]

  @@unique([projectId, code])
  @@unique([id, projectId])
  @@unique([wbsNodeId, position])
  @@index([projectId, status, code])
  @@index([ownerMembershipId, status])
  @@index([responsibilityPackageId, status])
  @@index([deliveryUnitId, status])
  @@index([moduleId, status])
  @@map("planning_tasks")
}

model ProjectCalendar {
  id          String                    @id @default(cuid())
  projectId   String                    @unique @map("project_id")
  status      PlanningCalendarStatus    @default(ACTIVE)
  version     Int                       @default(1)
  closedAt    DateTime?                 @map("closed_at")
  createdById String                    @map("created_by_id")
  updatedById String                    @map("updated_by_id")
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")
  project     Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  revisions   ProjectCalendarRevision[]
  createdBy   User                      @relation("ProjectCalendarCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User                      @relation("ProjectCalendarUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([id, projectId])
  @@index([status, updatedAt])
  @@map("project_calendars")
}

model ProjectCalendarRevision {
  id                     String                  @id @default(cuid())
  calendarId             String                  @map("calendar_id")
  projectId              String                  @map("project_id")
  revision               Int
  name                   String
  timeZone               String                  @map("time_zone")
  weeklyRules            Json                    @map("weekly_rules")
  exceptions             Json
  checksum               String
  reason                 String
  createdById            String                  @map("created_by_id")
  createdAt              DateTime                @default(now()) @map("created_at")
