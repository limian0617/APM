le                   ProjectModule?             @relation(fields: [moduleId, projectId], references: [id, projectId], onDelete: Restrict)\n  ownerMembership          ProjectMember              @relation(fields: [ownerMembershipId, projectId], references: [id, projectId], onDelete: Restrict)\n  createdBy                User                       @relation("PlanningTaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)\n  updatedBy                User                       @relation("PlanningTaskUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)\n  predecessorDependencies  TaskDependency[]           @relation("TaskDependencyPredecessor")\n  successorDependencies    TaskDependency[]           @relation("TaskDependencySuccessor")\n  milestoneLinks           ProjectMilestoneTaskLink[] @relation("PlanningTaskMilestoneLinks")\n  scheduleForecasts        ScheduleTaskForecast[]\n\n  @@unique([projectId, code])\n  @@unique([id, projectId])\n  @@unique([wbsNodeId, position])\n  @@index([projectId, status, code])\n  @@index([ownerMembershipId, status])\n  @@index([responsibilityPackageId, status])\n  @@index([deliveryUnitId, status])\n  @@index([moduleId, status])\n  @@map("planning_tasks")\n}\n\nmodel ProjectCalendar {\n  id          String                    @id @default(cuid())\n  projectId   String                    @unique @map("project_id")\n  status      PlanningCalendarStatus    @default(ACTIVE)\n  version     Int                       @default(1)\n  closedAt    DateTime?                 @map("closed_at")\n  createdById String                    @map("created_by_id")\n  updatedById String                    @map("updated_by_id")\n  createdAt   DateTime                  @default(now()) @map("created_at")\n  updatedAt   DateTime                  @updatedAt @map("updated_at")\n  project     Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)\n  revisions   ProjectCalendarRevision[]\n  createdBy   User                      @relation("ProjectCalendarCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)\n  updatedBy   User                      @relation("ProjectCalendarUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)\n\n  @@unique([id, projectId])\n  @@index([status, updatedAt])\n  @@map("project_calendars")\n}\n\nmodel ProjectCalendarRevision {\n  id                     String                  @id @default(cuid())\n  calendarId             String                  @map("calendar_id")\n  projectId              String                  @map("project_id")\n  revision               Int\n  name                   String\n  timeZone               String                  @map("time_zone")\n  weeklyRules            Json                    @map("weekly_rules")\n  exceptions             Json\n  checksum               String\n  reason                 String\n  createdById            String                  @map("created_by_id")\n  createdAt              DateTime                @default(now()) @map("created_at")\n  calendar               ProjectCalendar         @relation(fields: [calendarId, projectId], references: [id, projectId], onDelete: Restrict)\n  project                Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)\n  createdBy              User                    @relation("ProjectCalendarRevisionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)\n  scheduleRecalculations ScheduleRecalculation[]\n\n  @@unique([calendarId, revision])\n  @@index([projectId, revision])\n  @@index([checksum])\n  @@map("project_calendar_revisions")\n}\n\nmodel TaskDependency {\n  id                String               @id @default(cuid())\n  projectId         String               @map("project_id")\n  predecessorTaskId String               @map("predecessor_task_id")\n  successorTaskId   String               @map("successor_task_id")\n  dependencyType    TaskDependencyType   @map("dependency_type")\n  lagMinutes        Int                  @default(0) @map("lag_minutes")\n  status            TaskDependencyStatus @default(ACTIVE)\n  version           Int                  @default(1)\n  closedAt          DateTime?            @map("closed_at")\n  createdById       String               @map("created_by_id")\n  updatedById       String               @map("updated_by_id")\n  createdAt         DateTime             @default(now()) @map("created_at")\n  updatedAt         DateTime             @updatedAt @map("updated_at")\n  project           Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)\n  predecessorTask   PlanningTask         @relation("TaskDependencyPredecessor", fields: [predecessorTaskId, projectId], references: [id, projectId], onDelete: Restrict)\n  successorTask     PlanningTask         @relation("TaskDependencySuccessor", fields: [successorTaskId, projectId], references: [id, projectId], onDelete: Restrict)\n  createdBy         User                 @relation("TaskDependencyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)\n  updatedBy         User                 @relation("TaskDependencyUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)\n\n  @@unique([projectId, predecessorTaskId, successorTaskId])\n  @@unique([id, projectId])\n  @@index([projectId, status, predecessorTaskId])\n  @@index([projectId, status, successorTaskId])\n  @@map("task_dependencies")\n}\n\nmodel PlanningBaseline {\n  id                     String                            @id @default(cuid())\n  projectId              String                            @map("project_id")\n  sourceGateSubmissionId String                            @map("source_gate_submission_id")\n  version                Int\n  planningInputVersion   Int                               @map("planning_input_version")\n  reason                 String\n  checksum               String\n  createdById            String                            @map("created_by_id")\n  createdAt              DateTime                          @default(now()) @map("created_at")\n  project                Project                           @relation(fields: [projectId], references: [id], onDelete: Restrict)\n  sourceGateSubmission   GateSubmission                    @relation("PlanningBaselineSourceGateSubmission", fields: [sourceGateSubmissionId, projectId], references: [id, projectId], onDelete: Restrict)\n  createdBy              User                              @relation("PlanningBaselineCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)\n  wbsSnapshots           PlanningBaselineWbsSnapshot[]\n  taskSnapshots          PlanningBaselineTaskSnapshot[]\n  dependencySnapshots    PlanningBaselineDependencySnapshot[]\n  milestoneSnapshots     PlanningBaselineMilestoneSnapshot[]\n  milestoneTaskLinkSnapshots PlanningBaselineMilestoneTaskLinkSnapshot[]\n  calendarSnapshot       PlanningBaselineCalendarSnapshot?\n\n  @@unique([projectId, version])\n  @@unique([id, projectId])\n  @@index([projectId, createdAt])\n  @@index([sourceGateSubmissionId])\n  @@map("planning_baselines")\n}\n\nmodel PlanningBaselineWbsSnapshot {\n  id              String           @id @default(cuid())\n  baselineId      String           @map("baseline_id")\n  projectId       String           @map("project_id")\n  sourceWbsNodeId String           @map("source_wbs_node_id")\n  snapshotJson    Json             @map("snapshot_json")\n  createdAt       DateTime         @default(now()) @map("created_at")\n  baseline        PlanningBaseline @relation(fields: [baselineId, projectId], references: [id, projectId], onDelete: Restrict)\n\n  @@unique([baselineId, sourceWbsNodeId])\n  @@index([projectId, baselineId])\n  @@map("planning_baseline_wbs_snapshots")\n}\n\nmodel PlanningBaselineTaskSnapshot {\n  id           String           @id @default(cuid())\n  baselineId   String           @map("baseline_id")\n  projectId    String           @map("project_id")\n  sourceTaskId String           @map("source_task_id")\n  snapshotJson Json             @map("snapshot_json")\n  createdAt    DateTime         @default(now()) @map("created_at")\n  baseline     PlanningBaseline @relation(fields: [baselineId, projectId], references: [id, projectId], onDelete: Restrict)\n\n  @@unique([baselineId, sourceTaskId])\n  @@index([projectId, baselineId])\n  @@map("planning_baseline_task_snapshots")\n}\n\nmodel PlanningBaselineDependencySnapshot {\n  id                 String           @id @default(cuid())\n  baselineId         String           @map("baseline_id")\n  projectId          String           @map("project_id")\n  sourceDependencyId String           @map("source_dependency_id")\n  snapshotJson       Json             @map("snapshot_json")\n  createdAt          DateTime         @default(now()) @map("created_at")\n  baseline           PlanningBaseline @relation(fields: [baselineId, projectId], references: [id, projectId], onDelete: Restrict)\n\n  @@unique([baselineId, sourceDependencyId])\n  @@index([projectId, baselineId])\n  @@map("planning_baseline_dependency_snapshots")\n}\n\nmodel PlanningBaselineMilestoneSnapshot {\n  id                String           @id @default(cuid())\n  baselineId        String           @map("baseline_id")\n  projectId         String           @map("project_id")\n  sourceMilestoneId String           @map("source_milestone_id")\n  snapshotJson      Json             @map("snapshot_json")\n  createdAt         DateTime         @default(now()) @map("created_at")\n  baseline          PlanningBaseline @relation(fields: [baselineId, projectId], references: [id, projectId], onDelete: Restrict)\n\n  @@unique([baselineId, sourceMilestoneId])\n  @@index([projectId, baselineId])\n  @@map("planning_baseline_milestone_snapshots")\n}\n\nmodel PlanningBaselineMilestoneTaskLinkSnapshot {\n  id                        String           @id @default(cuid())\n  baselineId                String           @map("baseline_id")\n  projectId                 String           @map("project_id")\n  sourceMilestoneTaskLinkId String           @map("source_milestone_task_link_id")\n  snapshotJson              Json             @map("snapshot_json")\n  createdAt                 DateTime         @default(now()) @map("created_at")\n  baseline                  PlanningBaseline @relation(fields: [baselineId, projectId], references: [id, projectId], onDelete: Restrict)\n\n  @@unique([baselineId, sourceMilestoneTaskLinkId])\n  @@index([projectId, baselineId])\n  @@map("planning_baseline_milestone_task_link_snapshots")\n}\n\nmodel PlanningBaselineCalendarSnapshot {\n  id                       String           @id @default(cuid())\n  baselineId               String           @map("baseline_id")\n  projectId                String           @map("project_id")\n  sourceCalendarId         String           @map("source_calendar_id")\n  sourceCalendarRevisionId String           @map("source_calendar_revision_id")\n  snapshotJson             Json             @map("snapshot_json")\n  createdAt                DateTime         @default(now()) @map("created_at")\n  baseline                 PlanningBaseline @relation(fields: [baselineId, projectId], references: [id, projectId], onDelete: Restrict)\n\n  @@unique([baselineId, projectId])\n  @@index([projectId, baselineId])\n  @@map("planning_baseline_calendar_snapshots")\n}\n\nmodel ProjectScheduleState {\n  projectId                      String                 @id @map("project_id")\n  inputVersion                   Int                    @default(0) @map("input_version")\n  latestPublishedInputVersion    Int?                   @map("latest_published_input_version")\n  latestPublishedRecalculationId String?                @unique @map("latest_published_recalculation_id")\n  updatedAt                      DateTime               @updatedAt @map("updated_at")\n  project                        Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)\n  latestPublishedRecalculation   ScheduleRecalculation? @relation("LatestPublishedScheduleRecalculation", fields: [latestPublishedRecalculationId], references: [id], onDelete: Restrict)\n\n  @@index([inputVersion])\n  @@map("project_schedule_states")\n}\n\nmodel ScheduleRecalculation {\n  id                 String                      @id @default(cuid())\n  projectId          String                      @map("project_id")\n  inputVersion       Int                         @map("input_version")\n  status             ScheduleRecalculationStatus @default(PENDING)\n  algorithmVersion   String                      @map("algorithm_version")\n  sourceAction       String                      @map("source_action")\n  reason             String\n  requestedById      String                      @map("requested_by_id")\n  calendarRevisionId String?                     @map("calendar_revision_id")\n  inputChecksum      String?                     @map("input_checksum")\n  inputSnapshot      Json?                       @map("input_snapshot")\n  resultChecksum     String?                     @map("result_checksum")\n  taskCount          Int?                        @map("task_count")\n  dependencyCount    Int?                        @map("dependency_count")\n  errorCode          String?                     @map("error_code")\n  errorMessage       String?                     @map("error_message")\n  requestedAt        DateTime                    @default(now()) @map("requested_at")\n  startedAt          DateTime?                   @map("started_at")\n  completedAt        DateTime?                   @map("completed_at")\n  updatedAt          DateTime                    @updatedAt @map("updated_at")\n  project            Project                     @relation(fields: [projectId], references: [id], onDelete: Restrict)\n  requestedBy        User                        @relation("ScheduleRecalculationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)\n  calendarRevision   ProjectCalendarRevision?    @relation(fields: [calendarRevisionId], references: [id], onDelete: Restrict)\n  publishedForState  ProjectScheduleState?       @relation("LatestPublishedScheduleRecalculation")\n  taskForecasts      ScheduleTaskForecast[]\n\n  @@unique([projectId, inputVersion])\n  @@unique([id, projectId])\n  @@index([projectId, status, requestedAt])\n  @@index([status, requestedAt])\n  @@map("schedule_recalculations")\n}\n\nmodel ScheduleTaskForecast {\n  id                String                @id @default(cuid())\n  recalculationId   String                @map("recalculation_id")\n  projectId         String                @map("project_id")\n  taskId            String                @map("task_id")\n  position          Int\n  durationMinutes   Int                   @map("duration_minutes")\n  predictedStartAt  DateTime              @map("predicted_start_at")\n  predictedFinishAt DateTime              @map("predicted_finish_at")\n  latestStartAt     DateTime              @map("latest_start_at")\n  latestFinishAt    DateTime              @map("latest_finish_at")\n  totalFloatMinutes Int                   @map("total_float_minutes")\n  isCritical        Boolean               @map("is_critical")\n  createdAt         DateTime              @default(now()) @map("created_at")\n  recalculation     ScheduleRecalculation @relation(fields: [recalculationId, projectId], references: [id, projectId], onDelete: Restrict)\n  project           Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)\n  task              PlanningTask          @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict)\n\n  @@unique([recalculationId, taskId])\n  @@index([projectId, isCritical, position])\n  @@index([projectId, taskId, createdAt])\n  @@map("schedule_task_forecasts")\n}\n\nmodel ProjectMember {\n  id                          String                  @id @default(cuid())\n  projectId                   String                  @map("project_id")\n  userId                      String                  @map("user_id")\n  projectRole                 ProjectRole             @map("project_role")\n  departmentId                String?                 @map("department_id")\n  assignedById                String                  @map("assigned_by_id")\n  joinedAt                    DateTime                @default(now()) @map("joined_at")\n  leftAt                      DateTime?               @map("left_at")\n  leftById                    String?                 @map("left_by_id")\n  version                     Int                     @default(1)\n  project                     Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)\n  user                        User                    @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Restrict)\n  assignedBy                  User                    @relation("ProjectMemberAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)\n  leftBy                      User?                   @relation("ProjectMemberLeftBy", fields: [leftById], references: [id], onDelete: Restrict)\n  ownedResponsibilityPackages ResponsibilityPackage[]\n  assignedPlanningTasks       PlanningTask[]\n  ownedResidualItems          ResidualItem[]             @relation("ResidualItemOwnerMembership")\n  verifiedResidualItems       ResidualItem[]             @relation("ResidualItemVerifierMembership")\n\n  @@unique([id, projectId])\n  @@index([projectId, leftAt])\n  @@index([userId, leftAt])\n  @@map("project_members")\n}\n\nmodel AuditLog {\n  id           String          @id @default(cuid())\n  actorId      String?         @map("actor_id")\n  action       AuditAction\n  objectType   AuditObjectType @map("object_type")\n  objectId     String?         @map("object_id")\n  projectId    String?         @map("project_id")\n  departmentId String?         @map("department_id")\n  requestId    String?         @map("request_id")\n  traceId      String?         @map("trace_id")\n  operationId  String?         @map("operation_id")\n  beforeJson   Json?           @map("before_json")\n  afterJson    Json?           @map("after_json")\n  metadataJson Json?           @map("metadata_json")\n  source       AuditSource\n  sourceIp     String?         @map("source_ip")\n  userAgent    String?         @map("user_agent")\n  reason       String?\n  result       AuditResult     @default(SUCCESS)\n  occurredAt   DateTime        @default(now()) @map("occurred_at")\n  actor        User?           @relation(fields: [actorId], references: [id], onDelete: Restrict)\n  project      Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)\n\n  @@index([actorId, occurredAt])\n  @@index([objectType, objectId, occurredAt])\n  @@index([projectId, occurredAt])\n  @@index([departmentId, occurredAt])\n  @@index([action, occurredAt])\n  @@map("audit_logs")\n}\n