model CockpitProjection {
  id                 String              @id @default(cuid())
  projectId          String              @map("project_id")
  sourceChecksum     String              @map("source_checksum")
  sourceVersionsJson Json                @map("source_versions_json")
  health             CockpitHealthStatus
  calculatedAt       DateTime            @map("calculated_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  exceptions         CockpitExceptionProjection[]

  @@unique([projectId, sourceChecksum])
  @@unique([id, projectId])
  @@index([projectId, calculatedAt])
  @@map("cockpit_projections")
}

model CockpitExceptionProjection {
  id            String                   @id @default(cuid())
  projectionId  String                   @map("projection_id")
  projectId     String                   @map("project_id")
  kind          CockpitExceptionKind
  sourceKey     String                   @map("source_key")
  severity      CockpitExceptionSeverity
  summary       String
  occurredAt    DateTime?                @map("occurred_at")
  drilldownPath String                   @map("drilldown_path")
  position      Int
  createdAt     DateTime                 @default(now()) @map("created_at")
  projection    CockpitProjection        @relation(fields: [projectionId, projectId], references: [id, projectId], onDelete: Restrict)
  project       Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectionId, kind, sourceKey])
  @@index([projectId, severity, occurredAt])
  @@map("cockpit_exception_projections")
}

model ResourceLoadProjection {
  id                 String                         @id @default(cuid())
  projectId          String                         @map("project_id")
  sourceChecksum     String                         @map("source_checksum")
  sourceVersionsJson Json                           @map("source_versions_json")
  calculatedAt       DateTime                       @map("calculated_at")
  createdAt          DateTime                       @default(now()) @map("created_at")
  project            Project                        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  people             ResourceLoadPersonProjection[]

  @@unique([projectId, sourceChecksum])
  @@unique([id, projectId])
  @@index([projectId, calculatedAt])
  @@map("resource_load_projections")
}

model ResourceLoadPersonProjection {
  id                String                 @id @default(cuid())
  projectionId      String                 @map("projection_id")
  projectId         String                 @map("project_id")
  ownerMembershipId String                 @map("owner_membership_id")
  personId          String                 @map("person_id")
  personName        String                 @map("person_name")
  departmentId      String                 @map("department_id")
  discipline        ProjectRole
  plannedDays       Int                    @map("planned_days")
  activeTaskCount   Int                    @map("active_task_count")
  createdAt         DateTime               @default(now()) @map("created_at")
  projection        ResourceLoadProjection @relation(fields: [projectionId, projectId], references: [id, projectId], onDelete: Restrict)
  project           Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  ownerMembership   ProjectMember          @relation(fields: [ownerMembershipId, projectId], references: [id, projectId], onDelete: Restrict)
  tasks             ResourceLoadTaskProjection[]

  @@unique([projectionId, ownerMembershipId])
  @@unique([id, projectionId, projectId])
  @@index([projectId, departmentId, discipline])
  @@map("resource_load_person_projections")
}

model ResourceLoadTaskProjection {
  id                 String                       @id @default(cuid())
  personProjectionId String                       @map("person_projection_id")
  projectionId       String                       @map("projection_id")
  projectId          String                       @map("project_id")
  taskId             String                       @map("task_id")
  taskCode           String                       @map("task_code")
  taskName           String                       @map("task_name")
  plannedStartAt     DateTime                     @map("planned_start_at")
  plannedFinishAt    DateTime                     @map("planned_finish_at")
  plannedDays        Int                          @map("planned_days")
  createdAt          DateTime                     @default(now()) @map("created_at")
  person             ResourceLoadPersonProjection @relation(fields: [personProjectionId, projectionId, projectId], references: [id, projectionId, projectId], onDelete: Restrict)

  @@unique([personProjectionId, taskId])
  @@index([projectId, taskId])
  @@map("resource_load_task_projections")
}

model ProjectScheduleState {
  projectId                      String                 @id @map("project_id")
  inputVersion                   Int                    @default(0) @map("input_version")
  latestPublishedInputVersion    Int?                   @map("latest_published_input_version")
  latestPublishedRecalculationId String?                @unique @map("latest_published_recalculation_id")
  updatedAt                      DateTime               @updatedAt @map("updated_at")
  project                        Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  latestPublishedRecalculation   ScheduleRecalculation? @relation("LatestPublishedScheduleRecalculation", fields: [latestPublishedRecalculationId], references: [id], onDelete: Restrict)

  @@index([inputVersion])
  @@map("project_schedule_states")
}

model ScheduleRecalculation {
  id                 String                      @id @default(cuid())
  projectId          String                      @map("project_id")
  inputVersion       Int                         @map("input_version")
  status             ScheduleRecalculationStatus @default(PENDING)
  algorithmVersion   String                      @map("algorithm_version")
  sourceAction       String                      @map("source_action")
  reason             String
  requestedById      String                      @map("requested_by_id")
  calendarRevisionId String?                     @map("calendar_revision_id")
  inputChecksum      String?                     @map("input_checksum")
  inputSnapshot      Json?                       @map("input_snapshot")
  resultChecksum     String?                     @map("result_checksum")
  taskCount          Int?                        @map("task_count")
  dependencyCount    Int?                        @map("dependency_count")
  errorCode          String?                     @map("error_code")
  errorMessage       String?                     @map("error_message")
  requestedAt        DateTime                    @default(now()) @map("requested_at")
  startedAt          DateTime?                   @map("started_at")
  completedAt        DateTime?                   @map("completed_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  project            Project                     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requestedBy        User                        @relation("ScheduleRecalculationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  calendarRevision   ProjectCalendarRevision?    @relation(fields: [calendarRevisionId], references: [id], onDelete: Restrict)
  publishedForState  ProjectScheduleState?       @relation("LatestPublishedScheduleRecalculation")
  taskForecasts      ScheduleTaskForecast[]

  @@unique([projectId, inputVersion])
  @@unique([id, projectId])
  @@index([projectId, status, requestedAt])
  @@index([status, requestedAt])
  @@map("schedule_recalculations")
}

model ScheduleTaskForecast {
  id                String                @id @default(cuid())
  recalculationId   String                @map("recalculation_id")
  projectId         String                @map("project_id")
  taskId            String                @map("task_id")
  position          Int
  durationMinutes   Int                   @map("duration_minutes")
  predictedStartAt  DateTime              @map("predicted_start_at")
  predictedFinishAt DateTime              @map("predicted_finish_at")
  latestStartAt     DateTime              @map("latest_start_at")
  latestFinishAt    DateTime              @map("latest_finish_at")
  totalFloatMinutes Int                   @map("total_float_minutes")
  isCritical        Boolean               @map("is_critical")
  createdAt         DateTime              @default(now()) @map("created_at")
  recalculation     ScheduleRecalculation @relation(fields: [recalculationId, projectId], references: [id, projectId], onDelete: Restrict)
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task              PlanningTask          @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict)

  @@unique([recalculationId, taskId])
  @@index([projectId, isCritical, position])
  @@index([projectId, taskId, createdAt])
  @@map("schedule_task_forecasts")
}

model ProjectMember {
  id                          String                  @id @default(cuid())
  projectId                   String                  @map("project_id")
  userId                      String                  @map("user_id")
  projectRole                 ProjectRole             @map("project_role")
  departmentId                String?                 @map("department_id")
  assignedById                String                  @map("assigned_by_id")
  joinedAt                    DateTime                @default(now()) @map("joined_at")
  leftAt                      DateTime?               @map("left_at")
  leftById                    String?                 @map("left_by_id")
  version                     Int                     @default(1)
  project                     Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user                        User                    @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy                  User                    @relation("ProjectMemberAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  leftBy                      User?                   @relation("ProjectMemberLeftBy", fields: [leftById], references: [id], onDelete: Restrict)
  ownedResponsibilityPackages ResponsibilityPackage[]
  assignedPlanningTasks       PlanningTask[]
  resourceLoadPersonProjections ResourceLoadPersonProjection[]
  ownedResidualItems          ResidualItem[]             @relation("ResidualItemOwnerMembership")
  verifiedResidualItems       ResidualItem[]             @relation("ResidualItemVerifierMembership")

  @@unique([id, projectId])
  @@index([projectId, leftAt])
  @@index([userId, leftAt])
  @@map("project_members")
}

model AuditLog {
  id           String          @id @default(cuid())
  actorId      String?         @map("actor_id")
  action       AuditAction
  objectType   AuditObjectType @map("object_type")
  objectId     String?         @map("object_id")
  projectId    String?         @map("project_id")
  departmentId String?         @map("department_id")
  requestId    String?         @map("request_id")
  traceId      String?         @map("trace_id")
  operationId  String?         @map("operation_id")
  beforeJson   Json?           @map("before_json")
  afterJson    Json?           @map("after_json")
  metadataJson Json?           @map("metadata_json")
  source       AuditSource
  sourceIp     String?         @map("source_ip")
  userAgent    String?         @map("user_agent")
  reason       String?
  result       AuditResult     @default(SUCCESS)
  occurredAt   DateTime        @default(now()) @map("occurred_at")
  actor        User?           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([actorId, occurredAt])
  @@index([objectType, objectId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([departmentId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}
