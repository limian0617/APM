  capabilityConfigurationStatus ProjectCapabilityConfigurationStatus @default(UNCONFIGURED) @map("capability_configuration_status")
  capabilitiesConfiguredAt      DateTime?                            @map("capabilities_configured_at")
  sourceTemplateVersionId       String?                              @map("source_template_version_id")
  sourceTemplateChecksum        String?                              @map("source_template_checksum")
  initializedAt                 DateTime?                            @map("initialized_at")
  mainControlStageId            String?                              @map("main_control_stage_id")
  mainControlStageProjectId     String?                              @map("main_control_stage_project_id")
  mainControlStageCode          String?                              @map("main_control_stage_code")
  mainControlStageStatus        ProjectStageExecutionStatus?        @map("main_control_stage_status")
  mainControlStageSequence      Int?                                 @map("main_control_stage_sequence")
  mainControlStageUpdatedAt     DateTime?                            @map("main_control_stage_updated_at")
