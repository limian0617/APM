# Copy to .env for local development. Do not commit credentials.
DATABASE_URL="postgresql://apm:apm@localhost:5432/apm?schema=public"
APP_BASE_URL="http://localhost:3000"
# Required in production while the provisional trusted-header identity adapter is used.
AUTH_TRUSTED_HEADER_SECRET=""
# APM-005 private MinIO/S3-compatible object storage. Use separate private buckets.
APM_S3_ENDPOINT="http://localhost:9000"
APM_S3_REGION="us-east-1"
APM_S3_ACCESS_KEY_ID=""
APM_S3_SECRET_ACCESS_KEY=""
APM_S3_FORCE_PATH_STYLE="true"
APM_S3_QUARANTINE_BUCKET="apm-quarantine"
APM_S3_CONTROLLED_BUCKET="apm-controlled"
# ClamAV is called only by the Worker; the Web process does not receive scanner access.
APM_CLAMAV_HOST="127.0.0.1"
APM_CLAMAV_PORT="3310"
APM_CLAMAV_VERSION=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_MESSAGE_ID_DOMAIN="localhost"
